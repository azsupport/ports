# What the ports azsupport/azsupport, ftp/curl, multimedia/ffmpeg, graphics/ImageMagick6,
# graphics/ImageMagick7, graphics/GraphicsMagick and misc/mc share (the design: the head of
# azsupport/static/Makefile). Each of
# them includes this file before bsd.port.mk; AZSUPPORT_PREFIX (/usr/local/azsupport),
# AZSUPPORT_STATIC (/usr/local/azsupport/static) and AZSUPPORT_STAMP come from Mk/bsd.overlay.mk.

MAINTAINER=	github@azsupport.com

# The revision of the build: AZSUPPORT_STAMP, the yymmddhh of the run, given by the
# builder (0 without it: bsd.port.mk reads PORTREVISION before
# Mk/bsd.overlay.mk, which sets it); above the PORTREVISION of the
# official port, so that a new build is an upgrade of the official package.
PORTREVISION=	${AZSUPPORT_STAMP:U0}

# our release files (the take lines, the bundled curl) in one place of DISTDIR
DIST_SUBDIR=	azsupport

# The scripts of this tree; the commit of the official tree (deps.conf of azsupport/azsupport)
AZSUPPORT_TOOLS=	${.CURDIR:H:H}/tools
AZSUPPORT_DEPS_CONF=	${.CURDIR:H:H}/azsupport/static/files/deps.conf
AZSUPPORT_PORTS_COMMIT!=	/usr/bin/awk '$$1 == "ports" { print $$2 }' ${AZSUPPORT_DEPS_CONF}

# The environment of a script: its stage in WRKDIR (do-install copies it into
# STAGEDIR), its results (AZSUPPORT_RESULTS: the builder may give a place that stays
# after make clean), the work directories of the official ports it makes, the
# distfiles (those of the official ports in DISTDIR, ours in DISTDIR/azsupport).
AZSUPPORT_STAGEDIR=	${WRKDIR}/azsupport-stage
AZSUPPORT_RESULTS?=	${WRKDIR}/azsupport-results
AZSUPPORT_ENV=		AZSUPPORT_PREFIX=${AZSUPPORT_PREFIX} AZSUPPORT_WORK=${WRKDIR}/azsupport-work \
		AZSUPPORT_STAGEDIR=${AZSUPPORT_STAGEDIR} AZSUPPORT_RESULTS=${AZSUPPORT_RESULTS} \
		AZSUPPORT_DEPS_CONF=${AZSUPPORT_DEPS_CONF} AZSUPPORT_DISTDIR=${DISTDIR} \
		AZSUPPORT_TAKE_DISTFILES=${DISTDIR}/${DIST_SUBDIR} PORTSDIR=${PORTSDIR}

# The annotations of the packages of tools/build-az.sh of azsupport/php-src
PKG_NOTES+=	cputype freebsd_ports built_by
PKG_NOTE_cputype=	${CPUTYPE:Ux86-64-v3}
PKG_NOTE_freebsd_ports=	${AZSUPPORT_PORTS_COMMIT}
PKG_NOTE_built_by=	the port ${PKGORIGIN} of https://github.com/azsupport/ports

# The plist: every file of the stage (tools/azsupport-plist.sh)
AZSUPPORT_PLIST=	${SH} ${AZSUPPORT_TOOLS}/azsupport-plist.sh ${STAGEDIR} ${PREFIX} >> ${TMPPLIST}

# The stage of the script into STAGEDIR, as it is (modes, links)
AZSUPPORT_COPY_STAGE=	${MKDIR} ${STAGEDIR} && (cd ${AZSUPPORT_STAGEDIR} && ${TAR} -cf - .) | \
		(cd ${STAGEDIR} && ${TAR} -xpf -)
