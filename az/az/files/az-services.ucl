# The trigger of pkg for the services of our packages (aZ, 20.11.2026: «почему бы в конце
# не предложить запустить: service php_fpm74 restart, service nginx restart, service
# vsftpd restart?»): at the end of a transaction (pkg upgrade, install, delete) that
# touched a package of a service, the commands that restart those services rc.conf
# enables. A package of ours has an empty directory share/az/services/<service> for each
# rc.d script it has and for the service its modules belong to (Mk/bsd.overlay.mk,
# az-services: php<NN>_fpm for the modules of PHP NN, the rc.d script of phpNN-fpm
# (Mk/Uses/php.mk), nginx for those of nginx, apache24 for those of Apache and
# phpNN-apache); pkg counts the directories of the packages of the transaction as
# touched and gives the trigger those that match (arg).
#
# For each such service whose rc.d script is there: its rcvar (the rcvar= or name= of the
# script, else <service>_enable), its value as rc.conf, rc.conf.local and the files
# rc.conf.d/<name> of /etc and /usr/local/etc set it (the last one wins); YES, TRUE, ON or
# 1: enabled. A module of PHP NN also names apache24 when libexec/apache24/libphp<NN>.so
# is there (phpNN-apache). Nothing is printed when no such service is enabled. The
# sandbox of pkg (capsicum): it reads files of the root of pkg only, runs nothing.
description: "the commands that restart the services of the packages of az of this transaction"
path_glob: [ "/usr/local/share/az/services/*" ]
trigger: {
	type: lua
	sandbox: true
	script: <<EOD
local localbase = "/usr/local"

-- the lines of a file, none when it cannot be read (a directory rc.conf.d/<name> too)
local function read_lines(path)
  local f = io.open(path, "r")
  if f == nil then
    return {}
  end
  local t = {}
  pcall(function()
    for line in f:lines() do
      t[#t + 1] = line
    end
  end)
  f:close()
  return t
end

-- the name and the rcvar of an rc.d script
local function rc_names(service)
  local lines = read_lines(localbase .. "/etc/rc.d/" .. service)
  if #lines == 0 then
    return nil
  end
  local name, rcvar = nil, nil
  for _, line in ipairs(lines) do
    local v = line:match('^%s*name%s*=%s*"?([%w_]+)"?')
    if v ~= nil and name == nil then
      name = v
    end
    v = line:match('^%s*rcvar%s*=%s*"?([%w_%${}]+)"?')
    if v ~= nil and rcvar == nil then
      rcvar = v
    end
  end
  name = name or service:gsub("[^%w_]", "_")
  if rcvar == nil then
    rcvar = name .. "_enable"
  else
    rcvar = rcvar:gsub("%${name}", name):gsub("%$name", name)
  end
  return name, rcvar
end

local function enabled(name, rcvar)
  local value = nil
  local files = {
    "/etc/rc.conf", "/etc/rc.conf.local",
    "/etc/rc.conf.d/" .. name, localbase .. "/etc/rc.conf.d/" .. name,
  }
  for _, path in ipairs(files) do
    for _, line in ipairs(read_lines(path)) do
      local k, v = line:match('^%s*([%w_]+)%s*=%s*"?([^"#%s]*)')
      if k == rcvar then
        value = v
      end
    end
  end
  if value == nil then
    return false
  end
  value = value:upper()
  return value == "YES" or value == "TRUE" or value == "ON" or value == "1"
end

local seen, wanted = {}, {}
local function want(service)
  if seen[service] then
    return
  end
  seen[service] = true
  local name, rcvar = rc_names(service)
  if name ~= nil and enabled(name, rcvar) then
    wanted[#wanted + 1] = service
  end
end

for _, dir in ipairs(arg) do
  local service = dir:match("/share/az/services/([^/]+)$")
  if service ~= nil then
    want(service)
    local v = service:match("^php(%d%d)_fpm$")
    if v ~= nil and pkg.stat(localbase .. "/libexec/apache24/libphp" .. v .. ".so") ~= nil then
      want("apache24")
    end
  end
end

if #wanted > 0 then
  table.sort(wanted)
  print("The packages of these services changed, restart them:")
  for _, service in ipairs(wanted) do
    print("service " .. service .. " restart")
  end
end
EOD
}
