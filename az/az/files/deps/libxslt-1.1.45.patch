Description: CVE-2026-125350, use-after-free in the cache of direct pattern matches (xsltTestCompMatch, libxslt/pattern.c)
Origin: Chromium third_party/libxslt/chromium/0008-Fix-use-after-free-in-direct-pattern-match-cache.patch (156.0.8078.96, Joey Arhar, 06.11.2026), as Gentoo carries it (dev-libs/libxslt files/libxslt-1.1.45-CVE-2026-125350.patch, bug 986081), -p0

--- libxslt/pattern.c
+++ libxslt/pattern.c
@@ -581,6 +581,15 @@ xsltTestCompMatchDirect(xsltTransformContextPtr ctxt, xsltCompMatchPtr comp,
 	    nocache = 1;
 
 	if (nocache == 0) {
+	    /*
+	     * xmlXPathEval can re-enter this function for the same cache
+	     * slot, e.g. through a lazily evaluated global variable whose
+	     * value runs xsl:number. The nested call may free or replace
+	     * the cached object, so re-read it instead of using the value
+	     * read before the evaluation.
+	     */
+	    list = (xmlXPathObjectPtr)
+		XSLT_RUNTIME_EXTRA_LST(ctxt, sel->lenExtra);
 	    if (list != NULL)
 		xmlXPathFreeObject(list);
 	    list = newlist;
--
