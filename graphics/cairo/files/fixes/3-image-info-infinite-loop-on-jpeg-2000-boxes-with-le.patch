Source: Debian cairo 1.18.6-1 (sid), debian/patches/image-info-Fix-infinite-loop-on-JPEG-2000-boxes-with-leng.patch

From: Ana Bobillo <anabobillo3@gmail.com>
Date: Fri, 23 Oct 2026 03:17:25 +0200
Subject: image-info: Fix infinite loop on JPEG 2000 boxes with length 0

_jpx_next_box() returns p + length. A box with a length of 0 thus
returned the same box again, and _jpx_find_box() looped forever when
the data contained such a box before the JP2 header box. Box lengths 1
to 7 were also used as they are, although 1 means that a 64-bit length
follows the box type and 2 to 7 are reserved.

Add _jpx_box_length() and use it in both _jpx_next_box() and
_jpx_match_box(). A length of 0 means that the box extends to the end
of the data, as the JPEG 2000 file format specifies. Boxes with a
64-bit length or a reserved length are not supported. The length is
compared with the remaining data instead of computing a pointer that
may lie beyond the end of the data.

_jpx_match_box() now also accepts a box that ends exactly at the end
of the data, which it rejected before.

(cherry picked from commit 89f049a35e4a1aeef65f48470bf0a09a715fc0df)

Origin: upstream, after 1.18.6
---
 src/cairo-image-info.c | 46 +++++++++++++++++++++++++++++++---------------
 1 file changed, 31 insertions(+), 15 deletions(-)

diff --git a/src/cairo-image-info.c b/src/cairo-image-info.c
index bdfee4e..7aa1652 100644
--- a/src/cairo-image-info.c
+++ b/src/cairo-image-info.c
@@ -165,16 +165,40 @@ static const unsigned char _jpx_signature[] = {
     0x00, 0x00, 0x00, 0x0c, 0x6a, 0x50, 0x20, 0x20, 0x0d, 0x0a, 0x87, 0x0a
 };
 
+/* Returns the length of the box starting at p, or 0 if the box is
+ * invalid or does not fit in the data. */
+static size_t
+_jpx_box_length (const unsigned char *p, const unsigned char *end)
+{
+    uint32_t length;
+
+    if (p + 8 > end)
+	return 0;
+
+    length = get_unaligned_be32 (p);
+
+    /* A length of 0 means that the box extends to the end of the data. */
+    if (length == 0)
+	return end - p;
+
+    /* A length of 1 means that a 64-bit length follows the box type.
+     * Such boxes are not supported, nor are the reserved lengths 2
+     * to 7. */
+    if (length < 8 || length > (size_t) (end - p))
+	return 0;
+
+    return length;
+}
+
 static const unsigned char *
 _jpx_next_box (const unsigned char *p, const unsigned char *end)
 {
-    if (p + 4 < end) {
-	uint32_t length = get_unaligned_be32 (p);
-	if (p + length < end)
-	    return p + length;
-    }
+    size_t length = _jpx_box_length (p, end);
+
+    if (length == 0)
+	return end;
 
-    return end;
+    return p + length;
 }
 
 static const unsigned char *
@@ -186,15 +210,7 @@ _jpx_get_box_contents (const unsigned char *p)
 static cairo_bool_t
 _jpx_match_box (const unsigned char *p, const unsigned char *end, uint32_t type)
 {
-    uint32_t length;
-
-    if (p + 8 < end) {
-	length = get_unaligned_be32 (p);
-	if (get_unaligned_be32 (p + 4) == type &&  p + length < end)
-	    return TRUE;
-    }
-
-    return FALSE;
+    return _jpx_box_length (p, end) != 0 && get_unaligned_be32 (p + 4) == type;
 }
 
 static const unsigned char *
