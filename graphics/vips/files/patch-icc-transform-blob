libvips 8.18 branch after 8.18.7 (8.18.8 not released yet), commit
b6afb1c99d44:
https://github.com/libvips/libvips/commit/b6afb1c99d448302e728222172e03b9e56d26a24

icc_import (and icc_transform, thumbnail with import_profile) with an input
profile that is not the embedded one, from a file or a built-in one, put the
data of that profile into the output image as a raw pointer, without a
reference to its blob: once the operation was freed, the output used freed
memory (libvips issue 5258). The blob is now set as a reference.

--- libvips/colour/icc_transform.c.orig
+++ libvips/colour/icc_transform.c
@@ -830,12 +830,12 @@ vips_icc_import_build(VipsObject *object)
 	 */
 	if (icc->non_standard_input_profile &&
 		icc->in_blob) {
-		const void *data;
-		size_t size;
+		GValue blob = G_VALUE_INIT;
 
-		data = vips_blob_get(icc->in_blob, &size);
-		vips_image_set_blob(colour->out, VIPS_META_ICC_NAME,
-			NULL, data, size);
+		g_value_init(&blob, VIPS_TYPE_BLOB);
+		g_value_set_boxed(&blob, icc->in_blob);
+		vips_image_set(colour->out, VIPS_META_ICC_NAME, &blob);
+		g_value_unset(&blob);
 	}
 
 	return 0;
