--- make/modules/java.desktop/Lib.gmk.orig	2026-10-27 21:45:31 UTC
+++ make/modules/java.desktop/Lib.gmk
@@ -40,8 +40,9 @@
 ################################################################################
 # Create the libjsound library
 
+# not on AIX, OpenBSD and FreeBSD (no ALSA there, make/autoconf/libraries.m4)
 ifeq ($(call isTargetOs, aix), false)
-ifneq ($(OPENJDK_TARGET_OS_ENV), bsd.openbsd)
+ifeq ($(filter bsd.openbsd bsd.freebsd, $(OPENJDK_TARGET_OS_ENV)), )
 
   LIBJSOUND_CFLAGS := \
       $(ALSA_CFLAGS) \
