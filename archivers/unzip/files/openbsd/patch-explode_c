From: OpenBSD archivers/unzip, patches/patch-explode_c
Subject: memmove(), not memcpy(), for the copies within the sliding window
 The source and the destination of a copy in the window of explode.c (the
 implode method) can overlap, on a normal archive too: undefined behaviour.
 OpenBSD's libc aborts on it (SIGABRT); FreeBSD's memcpy() copies forward on
 amd64 and gives the right data, but its __memcpy_chk of _FORTIFY_SOURCE would
 abort as well. memmove() is defined for overlapping regions.
Origin: https://github.com/openbsd/ports/commit/89a66a1dff2e6f28933fc45957b6b62615dbfd71
 (13.01.2025), as it is, -p0

--- explode.c.orig	Sun Dec  2 03:20:24 2007
+++ explode.c	Mon Jan 13 18:12:59 2025
@@ -336,7 +336,7 @@ unsigned bdl;                   /* number of distance 
 #ifndef NOMEMCPY
           if (w - d >= e)       /* (this test assumes unsigned comparison) */
           {
-            memcpy(redirSlide + w, redirSlide + d, e);
+            memmove(redirSlide + w, redirSlide + d, e);
             w += e;
             d += e;
           }
@@ -454,7 +454,7 @@ unsigned bdl;           /* number of distance low bits
 #ifndef NOMEMCPY
           if (w - d >= e)       /* (this test assumes unsigned comparison) */
           {
-            memcpy(redirSlide + w, redirSlide + d, e);
+            memmove(redirSlide + w, redirSlide + d, e);
             w += e;
             d += e;
           }
