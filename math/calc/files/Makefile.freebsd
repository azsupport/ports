# vim:ft=make
ARCH_CFLAGS:=
BINDIR:=	${PREFIX}/bin
CALC_INCDIR:=	${PREFIX}/include/calc
CALC_SHAREDIR:=	${DATADIR}
CALCPAGER:=	more
CC:=		%%CC%%
CFLAGS:=	%%CFLAGS%% ${ICFLAGS} ${CCOPT}
INCDIR:=	${LOCALBASE}/include
LCC:=		%%CC%%
LIBDIR:=	${PREFIX}/lib
# calc.usage, the page formatted by man(1) for the cat page (calc.cat1), which is not
# installed (CATDIR empty): without man, which the world of the build has not
# (WITHOUT_MAN of its src.conf; "man: not found", build-jail.yml 45541471348)
MAN:=		true
MANDIR:=	${PREFIX}/share/man/man1
SCRIPTDIR:=	${PREFIX}/libexec/cscript
T:=		${DESTDIR}
USE_READLINE:=	-DUSE_READLINE -I%%AZ%%/include

# These need to be in this order:
READLINE_LIBS:=		-L%%AZ%%/lib -Wl,-rpath,%%AZSUPPORT_PREFIX%%/lib -lreadline
READLINE_EXTRAS:=	${READLINE_LIBS} -lhistory -lncurses

# The run path of calc: the libraries of azsupport first, then libcalc and libcustcalc of
# ${LIBDIR}; the LD_SHARE of Makefile.target for FreeBSD put the build directory, /lib,
# /usr/lib and ${LIBDIR} before them, so that calc took the readline of the ports in
# /usr/local/lib (libreadline.so.8, libhistory.so.8) wherever one is installed
# (tests/ports/utils-test.sh of azsupport, run 44807210093); the build directory for
# the link only (-rpath-link)
LD_SHARE:=	%%LDFLAGS%% -Wl,-rpath,%%AZSUPPORT_PREFIX%%/lib:${LIBDIR} -Wl,-rpath-link,${PWD}

# The protections of the linker (26.11.2026, readelf: calc EXEC, calc, libcalc and
# libcustcalc without BIND_NOW): LDFLAGS of the framework (-pie, -Wl,-zrelro, -Wl,-znow)
# in LD_SHARE above (the links of calc and of the sample programs, whose objects have
# CFLAGS with -fPIE) and in the flags of the links of the two libraries (the driver
# leaves -pie out with -shared); not in EXTRA_LDFLAGS: the programs the build runs
# itself (ILDFLAGS) are compiled without CFLAGS (no -fPIE)
LIBCALC_SHLIB:=	-shared "-Wl,-soname,libcalc${LIB_EXT_VERSION}" %%LDFLAGS%%
LIBCUSTCALC_SHLIB:=	-shared "-Wl,-soname,libcustcalc${LIB_EXT_VERSION}" %%LDFLAGS%%
