
Description: conncache: an idle HTTP/1.1 connection with input pending is not
 reused (the stray bytes came back as the response to the next request, and
 every later one was shifted), as ftp/curl of this tree has it
 (azsupport/azsupport/files/curl/curl-8.23.0.patch).
Origin: upstream https://github.com/curl/curl/commit/ef6b17cf12d4af4dfb2af4f9bc35861772be71c7
 (lib/conncache.c, after 8.23.0; as Gentoo net-misc/curl 8.23.0-r1 carries it).
 Appended to patches/curl.patch by the port.

diff --git a/lib/conncache.c b/lib/conncache.c
--- a/lib/conncache.c
+++ b/lib/conncache.c
@@ -1044,11 +1044,20 @@ bool Curl_cpool_conn_seems_healthy(struct connectdata *conn,
 {
   struct Curl_easy *admin;
   bool healthy = TRUE;
+  bool poll_input;
 
   DEBUGASSERT(!data->conn);
   if(cpool_conn_can_be_closed(conn) && cpool_conn_too_old(data, conn, pnow))
     return FALSE;
-  if((curlx_ptimediff_ms(pnow, &conn->created) - conn->lastchecked_ms) < 1000)
+
+  /* An idle, non-multiplexed connection must not be reused when it has
+   * input pending (RFC 9112, section 9.2), so that is polled on every
+   * reuse. The once a second limit only applies to the other checks. */
+  poll_input = cpool_conn_can_be_closed(conn) &&
+    !Curl_conn_is_multiplex(conn, FIRSTSOCKET) &&
+    !conn->scheme->run->connection_is_dead;
+  if(!poll_input &&
+     (curlx_ptimediff_ms(pnow, &conn->created) - conn->lastchecked_ms) < 1000)
     return TRUE;
 
   admin = Curl_get_admin(data);
@@ -1063,8 +1072,7 @@ bool Curl_cpool_conn_seems_healthy(struct connectdata *conn,
     Curl_attach_connection(admin, conn, FALSE);
     healthy = Curl_conn_is_alive(admin, conn, &input_pending);
     Curl_detach_connection(admin);
-    if(healthy && input_pending && cpool_conn_can_be_closed(conn) &&
-       !Curl_conn_is_multiplex(conn, FIRSTSOCKET)) {
+    if(healthy && input_pending && poll_input) {
       /* Non-multiplexed connections without attached transfers should
        * not have input pending. The input might be a TLS Notify Close,
        * for all we know. */

Description: cf-https-connect: the selection of the ALPN ends when no other allowed
 ALPN can make a connection attempt, without waiting for the HTTPS record (HTTPS-RR)
 of the DNS: a TLS failure keeps its own error instead of becoming a timeout behind
 that query (curl_cffi issue 900); this curl is built with HTTPSRR (c-ares).
Origin: upstream https://github.com/curl/curl/commit/228bd1510b641a2cf07ae2177a6382dc27107bd7
 (lib/cf-https-connect.c, after 8.23.0; the same file has blob fbef123906 in 8.23.0),
 as curl-impersonate carries it on its main
 (https://github.com/lexiforest/curl-impersonate/commit/e600127908b921b9e5b0bf9ec1b6cbeb1698001a,
 after 2.3.2); its tests left out. Appended to patches/curl.patch by the port.

diff --git a/lib/cf-https-connect.c b/lib/cf-https-connect.c
index fbef123906..735f38ffc3 100644
--- a/lib/cf-https-connect.c
+++ b/lib/cf-https-connect.c
@@ -286,6 +286,27 @@ static bool cf_hc_may_h3(struct Curl_cfilter *cf,
   return !ctx->check_h3_result;
 }
 
+static bool cf_hc_may_choose_alpn(struct Curl_cfilter *cf,
+                                   struct Curl_easy *data,
+                                   enum alpnid maybe,
+                                   enum alpnid already_using)
+{
+  http_majors allowed = data->state.http_neg.allowed;
+
+  if(maybe == already_using)
+    return FALSE;
+  switch(maybe) {
+  case ALPN_h1:
+    return (allowed & CURL_HTTP_V1x) != 0;
+  case ALPN_h2:
+    return (allowed & CURL_HTTP_V2x) != 0;
+  case ALPN_h3:
+    return (allowed & CURL_HTTP_V3x) && cf_hc_may_h3(cf, data);
+  default:
+    return FALSE;
+  }
+}
+
 static enum alpnid cf_hc_get_httpsrr_alpn(struct Curl_cfilter *cf,
                                           struct Curl_easy *data,
                                           enum alpnid not_this_one)
@@ -450,6 +471,14 @@ static void cf_hc_set_baller2(struct Curl_cfilter *cf,
 
   if(ctx->ballers_complete)
     return; /* already done */
+  /* HTTPS-RR can select h1 and h2 as separate attempts. Only finish
+   * selection early when no other allowed ALPN can be used. */
+  if(!cf_hc_may_choose_alpn(cf, data, ALPN_h1, alpn1) &&
+     !cf_hc_may_choose_alpn(cf, data, ALPN_h2, alpn1) &&
+     !cf_hc_may_choose_alpn(cf, data, ALPN_h3, alpn1)) {
+    ctx->ballers_complete = TRUE;
+    return;
+  }
   if(!ctx->httpsrr_resolved)
     return; /* HTTPS-RR pending */
 
