--- sysutil.c
+++ sysutil.c
@@ -2791,6 +2791,62 @@ error:
   die("reopening standard file descriptors to /dev/null failed");
 }
 
+void
+vsf_sysutil_detach_stdio_from_socket(int sock_fd)
+{
+  /* stdout and stderr must never refer to the client connection. Library
+   * code we call into (NSS modules such as NIS, PAM modules, libwrap, ...)
+   * may print diagnostics there, which would then end up being injected into
+   * the FTP control connection. This happens in inetd mode, where the super
+   * server typically passes the connected socket on fds 0, 1 and 2.
+   */
+  struct stat sock_stat;
+  int fd;
+  int null_fd = -1;
+  if (fstat(sock_fd, &sock_stat) != 0)
+  {
+    /* Leave reporting this to the regular sanity checks. */
+    return;
+  }
+  for (fd = STDOUT_FILENO; fd <= STDERR_FILENO; ++fd)
+  {
+    struct stat fd_stat;
+    if (fd == sock_fd)
+    {
+      continue;
+    }
+    if (fstat(fd, &fd_stat) == 0)
+    {
+      if (fd_stat.st_dev != sock_stat.st_dev ||
+          fd_stat.st_ino != sock_stat.st_ino)
+      {
+        /* Something else, e.g. the journal or a log file - keep it. */
+        continue;
+      }
+    }
+    else if (errno != EBADF)
+    {
+      continue;
+    }
+    /* Either the client socket, or closed. A closed fd would be handed out
+     * by the next open()/socket() call, so plug it with /dev/null as well.
+     */
+    if (null_fd < 0)
+    {
+      null_fd = open("/dev/null", O_WRONLY, 0);
+      if (null_fd < 0)
+      {
+        die("open /dev/null");
+      }
+    }
+    vsf_sysutil_dupfd2(null_fd, fd);
+  }
+  if (null_fd > STDERR_FILENO)
+  {
+    vsf_sysutil_close(null_fd);
+  }
+}
