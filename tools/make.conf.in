# The make.conf of a run of tools/build.sh: written into <work>/make.conf with the
# values of the run (the @...@ words) and given to make as __MAKE_CONF, so that the
# /etc/make.conf of a build server is neither read nor changed.
#
# The first part is the make.conf of aZ's servers: the same lines go into the
# make.conf of poudriere (poudriere.d/make.conf), which sets the paths itself.

# the x86-64 level of the run (x86-64-v3 or x86-64-v2): bsd.cpu.mk makes -march of it
CPUTYPE?=@CPUTYPE@
# the framework adds -fstack-protector-strong (bsd.ssp.mk)
CFLAGS=-O3 -pipe -fno-strict-aliasing
# the kernel of the servers (make buildkernel, sys/conf/kern.pre.mk); the ports and the
# kernel modules of the ports do not read it (sys/conf/kmod.mk)
COPTFLAGS=-O3 -pipe
# the ports with USES=jpeg (gd, ImageMagick) take mozjpeg, as on the servers
JPEG_PORT=graphics/mozjpeg
# the ports with USES=mysql take the client of our MariaDB 10.11
# (databases/mariadb1011-client; the default of the ports is MySQL 8.4), as on the
# servers (aZ, 15.11.2026); Python 3.12 (lang/python312) and Ruby 3.4 (lang/ruby34)
# fixed as well, so that a move of PYTHON_DEFAULT or RUBY_DEFAULT of the pinned tree
# changes no port of ours (aZ, 20.11.2026: «дефолтный руби добавляй в наш make.conf как и
# марию и питон»; it builds every port again, so it goes in with the build runners)
DEFAULT_VERSIONS+=mysql=10.11m python=3.12 ruby=3.4
DISABLE_VULNERABILITIES=yes
DISABLE_LICENSES=yes
BATCH=yes
# DTRACE too (aZ, 11.11.2026): faster, and not needed in production; NLS too (the
# translations and libintl; aZ, 15.11.2026: off everywhere, from 16.11.2026)
OPTIONS_UNSET=X11 WAYLAND GUI DBUS CUPS DEBUG TEST DOCS EXAMPLES INFO MAN3 MANPAGES DTRACE NLS
# the kernel of the servers where its config is (az.st of aZ; a build machine has none)
.if exists(/usr/src/sys/amd64/conf/az.st)
KERNCONF=az.st
.endif

# The paths of tools/build.sh. PORT_DBDIR is its own and empty, so that the options
# saved by make config on a build server (/var/db/ports) do not change a build: only
# the Makefiles of the ports and the lines above decide.
PORTSDIR=@PORTSDIR@
OVERLAYS=@OVERLAYS@
WRKDIRPREFIX=@WRKDIRPREFIX@
PACKAGES=@PACKAGES@
DISTDIR=@DISTDIR@
PORT_DBDIR=@PORT_DBDIR@
