ngx_http_headers_more_module: more_set_input_headers -r of a header of several
values (Cookie and the like) on a request without it: the helper returned no
header and left the pointer uninitialized, and the module wrote through it into
the list of headers (nginx 1.23 and newer). The pointer initialized and the
update skipped when it stays NULL. Upstream e30b10e0bb1c of
openresty/headers-more-nginx-module (19.11.2026), after v0.41. Applied by
post-patch in WRKSRC_headers_more, -p0.

--- src/ngx_http_headers_more_headers_in.c.orig
+++ src/ngx_http_headers_more_headers_in.c
@@ -799,11 +799,12 @@ ngx_http_set_builtin_multi_header(ngx_http_request_t *r,
         *headers = NULL;
     }
 
+    h = NULL;
     if (ngx_http_set_header_helper(r, hv, value, &h) == NGX_ERROR) {
         return NGX_ERROR;
     }
 
-    if (value->len == 0) {
+    if (h == NULL) {
         return NGX_OK;
     }
 
@@ -860,7 +861,7 @@ ngx_http_set_builtin_multi_header(ngx_http_request_t *r,
         return NGX_ERROR;
     }
 
-    if (value->len == 0) {
+    if (h == NULL) {
         return NGX_OK;
     }
 
