-        rc = ZSTD_compressStream(ctx->cstream, &ctx->buffer_out,
-                                 &ctx->buffer_in);
+
+        /*
+         * ZSTD_compressStream2(): what it returns is the data left to
+         * flush, as the two calls above; ZSTD_compressStream() returns a
+         * hint of the size of the next input, which is never 0
