+/*
+ * The length of the response to zstd: a hint of it when it is known, the
+ * window for an unknown one else
+ */
+
+static ngx_int_t
+ngx_http_zstd_filter_set_size(ngx_http_request_t *r, ngx_http_zstd_ctx_t *ctx,
+    ZSTD_CStream *cstream)
+{
+    int     wlog;
+    off_t   len;
+    size_t  rc;
+
+    len = ctx->content_length;
+
+#ifdef ZSTD_c_srcSizeHint
+
+    if (len >= 0) {
+
+        /* zstd takes 0 for no hint: the smallest one for an empty response */
+
+        if (len == 0) {
+            len = 1;
+
+        } else if (len > NGX_HTTP_ZSTD_SIZE_HINT_MAX) {
+            len = NGX_HTTP_ZSTD_SIZE_HINT_MAX;
+        }
+
+        rc = ZSTD_CCtx_setParameter(cstream, ZSTD_c_srcSizeHint, (int) len);
+        if (!ZSTD_isError(rc)) {
+            return NGX_OK;
+        }
+
+        /* a libzstd that does not take the hint: the window by the length */
+
+        ngx_log_debug1(NGX_LOG_DEBUG_HTTP, r->connection->log, 0,
+                       "ZSTD_CCtx_setParameter(ZSTD_c_srcSizeHint) failed: %s",
+                       ZSTD_getErrorName(rc));
+    }
+
+#endif
+
+    wlog = NGX_HTTP_ZSTD_WINDOW_LOG_UNKNOWN;
+
+    if (len >= 0) {
+
+        /*
+         * the smallest window that holds the response, and not above that
+         * of an unknown length, which no level is below
+         */
+
+        wlog = NGX_HTTP_ZSTD_WINDOW_LOG_MIN;
+
+        while (wlog < NGX_HTTP_ZSTD_WINDOW_LOG_UNKNOWN
+               && ((off_t) 1 << wlog) < len)
+        {
+            wlog++;
+        }
+    }
+
+    rc = ZSTD_CCtx_setParameter(cstream, ZSTD_c_windowLog, wlog);
+    if (ZSTD_isError(rc)) {
+        ngx_log_error(NGX_LOG_ALERT, r->connection->log, 0,
+                      "ZSTD_CCtx_setParameter(ZSTD_c_windowLog) failed: %s",
+                      ZSTD_getErrorName(rc));
+
+        return NGX_ERROR;
+    }
+
+    return NGX_OK;
+}
