# www/nginx-devel-dav: the DAV module of nginx for www/nginx-devel of azsupport/ports,
# a package of its own (aZ, 18.11.2026: «мне в нгингс ещё надо для одного сервера
# http_webdav, его модулем можешь сделать?»): PUT, DELETE, MKCOL, COPY and MOVE;
# PROPFIND, OPTIONS, LOCK and UNLOCK are www/nginx-devel-dav-ext. The design is in the
# head of www/nginx-devel/Makefile.

NGINX_AZ_MODULE=	dav
COMMENT=	WebDAV module of nginx for nginx-devel (of azsupport/ports)
MASTERDIR=	${.CURDIR}/../nginx-devel

.include "${MASTERDIR}/Makefile"
