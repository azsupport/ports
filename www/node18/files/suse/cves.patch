+timeout.unref();
+
+const bufferBinding = internalBinding('buffer');
+
+// 1. Insecure toggle must be removed
+assert.strictEqual(bufferBinding.getZeroFillToggle, undefined);
+
+// 2. New secure creation API must exist
+assert.strictEqual(typeof bufferBinding.createUnsafeArrayBuffer, 'function');
+
+// 3. Functional behavior of secure unsafe array buffer allocation
+const size = 128;
+const ab = bufferBinding.createUnsafeArrayBuffer(size);
+assert.ok(ab instanceof ArrayBuffer);
+assert.strictEqual(ab.byteLength, size);
+
+clearTimeout(timeout);
