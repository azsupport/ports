diff --git a/test/parallel/test-undici-duplicate-headers.js b/test/parallel/test-undici-duplicate-headers.js
new file mode 100644
index 00000000000..553723fb908
--- /dev/null
+++ b/test/parallel/test-undici-duplicate-headers.js
@@ -0,0 +1,65 @@
+'use strict';
+
+const common = require('../common');
+const assert = require('assert');
+const { request } = require('../../deps/undici/src/index.js');
+
+// Timeout protection to prevent hanging
+const timer = setTimeout(() => {
+  assert.fail('Test timed out');
+}, 4000);
+timer.unref();
+
+async function runTest() {
+  // Test Case 1: Duplicate Host headers in array format should throw InvalidArgumentError
+  await assert.rejects(
+    async () => {
+      await request('http://localhost:12345', {
+        headers: [
+          'Host', 'example.com',
+          'host', 'another.com'
+        ]
+      });
+    },
+    {
+      name: 'InvalidArgumentError',
+      message: 'duplicate host header'
+    }
+  );
+
+  // Test Case 2: Duplicate Content-Length headers in array format should throw InvalidArgumentError
+  await assert.rejects(
+    async () => {
+      await request('http://localhost:12345', {
+        method: 'POST',
+        headers: [
+          'Content-Length', '10',
+          'content-length', '20'
+        ],
+        body: 'abc'
+      });
+    },
+    {
+      name: 'InvalidArgumentError',
+      message: 'duplicate content-length header'
+    }
+  );
+
+  // Test Case 3: Invalid upgrade header should throw InvalidArgumentError
+  await assert.rejects(
+    async () => {
+      await request('http://localhost:12345', {
+        upgrade: 'websocket\r\n'
+      });
+    },
+    {
+      name: 'InvalidArgumentError',
+      message: 'invalid upgrade header'
+    }
+  );
+
+  clearTimeout(timer);
+  console.log('All tests passed successfully!');
+}
+
+runTest().catch(common.mustNotCall());
