# www/nginx-devel-testcookie: the testcookie module of www/nginx-devel of azsupport/ports,
# a package of its own (aZ, 17.11.2026): a client is served only after it gives back the
# cookie the module sets (with a redirect or a page), so bots that keep no cookies are not;
# the design is in the head of www/nginx-devel/Makefile.

NGINX_AZ_MODULE=	testcookie
COMMENT=	Cookie challenge module for nginx-devel (of azsupport/ports)
MASTERDIR=	${.CURDIR}/../nginx-devel

.include "${MASTERDIR}/Makefile"
