# www/nginx-devel-stream: the stream module of www/nginx-devel of azsupport/ports, a
# package of its own (aZ, 15.11.2026: «stream модулем, на 90% других серверов он не
# юзается»): stream with realip, ssl and ssl_preread, and the stream part of geoip2
# (its http part is in the core); the design is in the head of www/nginx-devel/Makefile.

NGINX_AZ_MODULE=	stream
COMMENT=	Stream (TCP/UDP proxy) module for nginx-devel (of azsupport/ports)
MASTERDIR=	${.CURDIR}/../nginx-devel

.include "${MASTERDIR}/Makefile"
