#!/bin/sh

# php-fpm of PHP 8.3 (the package php83-fpm of azsupport/ports): the rc.d script
# php_fpm of the port lang/php84 of freebsd-ports f16b6dd0f7c1 with names of its
# own, so that the php-fpm of several versions of PHP run at once
# (php83_fpm_enable="YES" in /etc/rc.conf), and with profiles in the way of the
# rc.d script of www/apache24: a profile is another configuration of the same
# PHP, the directory %%PREFIX%%/etc/php83-<profile> (php83-profile --create
# <profile>), run as an instance of its own.

# PROVIDE: php83_fpm
# REQUIRE: LOGIN
# KEYWORD: shutdown

#
# Add the following line to /etc/rc.conf to enable php83_fpm:
# php83_fpm_enable (bool):        Set to "NO" by default.
#                               Set it to "YES" to enable php83_fpm
# php83_fpm_profiles (str):       Set to "" by default.
#                               The profiles run after the default instance,
#                               e.g. "tds a b".
# php83_fpm_<profile>_enable (bool): Set to the value of php83_fpm_enable by
#                               default.
# php83_fpm_<profile>_flags (str): Set to "" by default.
#                               More flags of php83-fpm for the profile.
#
# Without a profile (service php83_fpm start): the default instance, then each
# enabled profile of php83_fpm_profiles. With one (service php83_fpm start tds,
# service php83_fpm configtest tds): only that profile, with
# php83-fpm -y %%PREFIX%%/etc/php83-tds/php-fpm.conf -c %%PREFIX%%/etc/php83-tds
# and PHPRC=%%PREFIX%%/etc/php83-tds PHP_INI_SCAN_DIR=%%PREFIX%%/etc/php83-tds/conf.d;
# its pid file the pid of that php-fpm.conf (/var/run/php83-fpm-tds.pid when it
# has none).

. /etc/rc.subr

name="php83_fpm"
rcvar=php83_fpm_enable

start_precmd="php83_fpm_prestart"
restart_precmd="php83_fpm_checkconfig"
reload_precmd="php83_fpm_checkconfig"
command="%%PREFIX%%/sbin/php83-fpm"
configtest_cmd="php83_fpm_checkconfig"
_pidprefix="/var/run"
pidfile="${_pidprefix}/php83-fpm.pid"
required_files="%%PREFIX%%/etc/php83/php-fpm.conf"
# the pid file of its php-fpm.conf (a relative one is under /var, as php-fpm takes it),
# else php83-fpm.pid: a php-fpm.conf of before 21.11.2026 has /var/run/php-fpm83.pid
_ppid="$(sed -n 's/^[[:space:]]*pid[[:space:]]*=[[:space:]]*//p' "%%PREFIX%%/etc/php83/php-fpm.conf" 2> /dev/null | head -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/')"
case "${_ppid}" in
/*)	pidfile="${_ppid}" ;;
?*)	pidfile="/var/${_ppid}" ;;
esac

load_rc_config "${name}"

: ${php83_fpm_enable="NO"}
: ${php83_fpm_umask=""}
: ${php83_fpm_svcj_options:="net_basic"}

profile=""
if [ -n "$2" ]; then
	profile="$2"
	case "${profile}" in
	*[!a-z0-9_]*)
		echo "$0: bad profile name '${profile}': a-z, 0-9 and _ only"
		exit 1
		;;
	esac
	_pdir="%%PREFIX%%/etc/php83-${profile}"
	if [ ! -f "${_pdir}/php-fpm.conf" ]; then
		echo "$0: no profile ${profile} of php83-fpm: no ${_pdir}/php-fpm.conf (php83-profile --create ${profile})"
		exit 1
	fi
	# the pid file of its php-fpm.conf (a relative one is under /var, as
	# php-fpm takes it), else php83-fpm-<profile>.pid
	_ppid="$(sed -n 's/^[[:space:]]*pid[[:space:]]*=[[:space:]]*//p' "${_pdir}/php-fpm.conf" | head -n 1 | sed -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/')"
	case "${_ppid}" in
	"")	pidfile="${_pidprefix}/php83-fpm-${profile}.pid" ;;
	/*)	pidfile="${_ppid}" ;;
	*)	pidfile="/var/${_ppid}" ;;
	esac
	required_files="${_pdir}/php-fpm.conf ${_pdir}/php.ini"
	eval php83_fpm_enable="\${php83_fpm_${profile}_enable:-${php83_fpm_enable}}"
	eval _pflags="\${php83_fpm_${profile}_flags:-}"
	php83_fpm_flags="-y ${_pdir}/php-fpm.conf -c ${_pdir} -g ${pidfile}${_pflags:+ ${_pflags}}"
	php83_fpm_env="PHPRC=${_pdir} PHP_INI_SCAN_DIR=${_pdir}/conf.d"
fi

extra_commands="reload configtest logrotate"
sig_stop="QUIT"
sig_reload="USR2"
logrotate_cmd="php83_fpm_logrotate"

php83_fpm_logrotate() {
        if [ -z "$rc_pid" ]; then
                _run_rc_notrunning
                return 1
        fi
        echo "Rotating logs $name."
        kill -USR1 $rc_pid
}

php83_fpm_checkconfig()
{
        echo "Performing sanity check on php-fpm configuration${profile:+ of the profile ${profile}}:"
        eval ${profile:+env ${php83_fpm_env} }${command} ${php83_fpm_flags} -t
}

php83_fpm_prestart()
{
	php83_fpm_checkconfig
	checkconfig=$?
	if [ $checkconfig -ne 0  ]; then
		return $checkconfig
	fi

	if [ ! -z "$php83_fpm_umask"  ]; then
		echo "Setting umask to: ${php83_fpm_umask}"
		umask $php83_fpm_umask
	fi
}

# Without a profile, with profiles: the default instance, then each enabled
# profile (this script with the profile); the status says what failed.
if [ -z "${profile}" ] && [ -n "${php83_fpm_profiles}" ] && [ -n "$1" ]; then
	_failed=""
	( run_rc_command "$1" ) || _failed="the default instance"
	for _p in ${php83_fpm_profiles}; do
		eval _e="\${php83_fpm_${_p}_enable:-${php83_fpm_enable}}"
		case "${_e}" in
		[Yy][Ee][Ss]|[Tt][Rr][Uu][Ee]|[Oo][Nn]|1)
			;;
		[Nn][Oo]|[Ff][Aa][Ll][Ss][Ee]|[Oo][Ff][Ff]|0|"")
			continue
			;;
		*)
			echo "Bad value '${_e}' for php83_fpm_${_p}_enable: the profile ${_p} skipped"
			continue
			;;
		esac
		echo "===> php83_fpm profile: ${_p}"
		%%PREFIX%%/etc/rc.d/php83_fpm "$1" "${_p}" || _failed="${_failed:+${_failed}, }${_p}"
	done
	if [ -n "${_failed}" ]; then
		echo "php83_fpm $1 failed: ${_failed}"
		exit 1
	fi
	exit 0
fi

run_rc_command "$1"
