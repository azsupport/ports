# The node-gyp build of sodium-native of net-im/rocketchat8 in the place of its CMake
# one, which fetches libsodium from git at build time: binding.c and its extensions,
# with the libsodium the port builds (static, PIC), as its CMakeLists.txt does.
{
  'targets': [
    {
      'target_name': 'sodium-native',
      'sources': [
        'binding.c',
        'extensions/tweak/tweak.c',
        'extensions/pbkdf2/pbkdf2.c'
      ],
      'include_dirs': [ '%%SODIUM%%/include' ],
      'defines': [ 'SODIUM_STATIC=1' ],
      'cflags': [ '-fvisibility=hidden' ],
      'libraries': [ '%%SODIUM%%/lib/libsodium.a' ]
    }
  ]
}
