# Makefile.npm of net-im/rocketchat8: the npm modules the port takes from registry.npmjs.org
# (RC_NPM_SERVER: <name>:<version>; RC_NPM_FIX: <its directory under
# programs/server/npm/node_modules>:<name>:<version>).
#
# RC_NPM_SERVER: the modules of programs/server, its npm-shrinkwrap.json without the ones
# for development; underscore 1.13.8 in the place of the 1.13.7 of the shrinkwrap
# (GHSA-qpx9-hpmf-5gmw, high; the bundle itself has 1.13.8; aZ, 18.11.2026 14:10: a fix
# of the same major version).
RC_NPM_SERVER=	@babel/parser:7.25.0 \
		@meteorjs/reify:0.25.4 \
		@types/estree:1.0.9 \
		@types/semver:7.5.8 \
		acorn:8.18.0 \
		asap:2.0.6 \
		estree-walker:2.0.2 \
		is-reference:1.2.1 \
		lru-cache:6.0.0 \
		magic-string:0.25.9 \
		periscopic:2.0.3 \
		promise:8.3.0 \
		semver:7.6.3 \
		source-map:0.5.7 \
		sourcemap-codec:1.4.8 \
		underscore:1.13.8 \
		yallist:4.0.0

