# lang/gcc16-libs: the run-time libraries of GCC 16 of azsupport/ports, a package of
# their own (libgcc_s.so.1, libstdc++.so.6, libatomic.so.1, libgomp.so.1 in
# lib/gcc16), for the programs built by GCC that a server runs without the compiler
# (sysutils/arcconf). The design is in the head of lang/gcc16/Makefile.

GCC_PART=	libs
COMMENT=	Run-time libraries of GCC 16 (of azsupport/ports)
MASTERDIR=	${.CURDIR}/../gcc16
DESCR=		${.CURDIR}/pkg-descr
PLIST=		${.CURDIR}/pkg-plist

.include "${MASTERDIR}/Makefile"
