# lang/erlang-runtime28 of azsupport/ports: the official port (Mk/az-official.mk), the
# Erlang/OTP 28 runtime of net/rabbitmq (aZ, 20.11.2026), with KQUEUE,
# OPENSSL (the crypto of the base system, which RabbitMQ needs) and SHARING of the
# official default; CHUNKS (the documentation in the console), CORBA and SCTP off,
# DTRACE off (tools/make.conf.in), JAVA, ODBC and WX off as in the official default.

AZ_OFFICIAL=	lang/erlang-runtime28
OPTIONS_EXCLUDE=	CHUNKS CORBA SCTP

.include "${.CURDIR:H:H}/Mk/az-official.mk"
