@comment The defaults of az for PHP 7.4 (aZ, 08.11.2026): appended to the
@comment php.ini-production of the tarball to make etc/php74/php.ini.sample
@comment (@sample: pkg copies it to php.ini and keeps a changed php.ini);
@comment php.ini-production and php.ini-development stay as they are. The
@comment lines that begin with @comment are not in it (SUB_FILES drops them).
@comment One file per version, files/php.ini-az-<PHP_VER>.in, chosen by PHP_VER
@comment of the Makefile. What the other versions change in this block: 5.6 has
@comment no session.sid_length, session.sid_bits_per_character,
@comment session.cookie_samesite, zend.exception_ignore_args,
@comment opcache.validate_permission, opcache.validate_root and
@comment opcache.huge_code_pages, has mysql.allow_persistent = Off and
@comment mysql.default_socket, and opcache.max_accelerated_files at most
@comment 100000; 8.4 has error_reporting = E_ALL & ~E_DEPRECATED and no
@comment session.sid_length and session.sid_bits_per_character.

; --- az: defaults of PHP 7.4, on top of php.ini-production above ---
[PHP]
expose_php = Off
short_open_tag = On
output_buffering = Off
memory_limit = 1024M
max_execution_time = 1800
max_input_time = 1800
max_input_vars = 10000
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT
display_errors = Off
display_startup_errors = Off
html_errors = Off
log_errors = On
error_log = /var/log/php%%PHP_VER%%_error.log
zend.exception_ignore_args = On
allow_url_include = Off
upload_max_filesize = 500M
post_max_size = 512M
cgi.fix_pathinfo = 0
date.timezone = UTC
realpath_cache_size = 4096K
realpath_cache_ttl = 600
zlib.output_compression = Off

[Pdo_mysql]
pdo_mysql.default_socket = /tmp/mysql.sock

[MySQLi]
mysqli.default_socket = /tmp/mysql.sock

[Session]
session.save_handler = files
; redis (php74-redis, redis on its socket); with it gc_probability = 0
;session.save_handler = redis
;session.save_path = "unix:///var/run/redis/redis.sock"
;session.gc_probability = 0
session.use_strict_mode = 1
session.use_only_cookies = 1
session.cookie_httponly = 1
session.cookie_samesite = Lax
session.sid_length = 48
session.sid_bits_per_character = 6
session.gc_probability = 1
session.gc_divisor = 1000

[opcache]
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 2048
opcache.interned_strings_buffer = 256
opcache.max_accelerated_files = 300000
opcache.max_wasted_percentage = 10
opcache.validate_timestamps = 1
opcache.revalidate_freq = 2
opcache.enable_file_override = 1
opcache.validate_permission = 1
opcache.validate_root = 1
opcache.huge_code_pages = 1
