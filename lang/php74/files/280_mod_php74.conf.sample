# PHP 7.4 as an Apache module (mod_php74 of azsupport/ports): copy this file to
# 280_mod_php74.conf in modules.d of the Apache instance that is to load it
# (one PHP module per instance), then restart that instance.
LoadModule php7_module libexec/apache24/libphp74.so
<IfModule php7_module>
    <FilesMatch "\.php$">
        SetHandler application/x-httpd-php
    </FilesMatch>
    <FilesMatch "\.phps$">
        SetHandler application/x-httpd-php-source
    </FilesMatch>
    DirectoryIndex index.php index.html
</IfModule>
