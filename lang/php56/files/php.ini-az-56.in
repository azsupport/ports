@comment The defaults of az for PHP 5.6, appended to the php.ini-production of
@comment the tarball to make etc/php56/php.ini.sample (@sample: pkg copies it
@comment to php.ini and keeps a changed php.ini), as for 7.4 (the head of
@comment lang/php74/files/php.ini-az-74.in). The block of 7.4 with what that
@comment head says 5.6 changes: the version in its first line and in the name
@comment of the log; no session.sid_length, session.sid_bits_per_character,
@comment session.cookie_samesite (PHP 7.1 and 7.3), zend.exception_ignore_args
@comment (7.4), opcache.validate_permission, opcache.validate_root (7.0) and
@comment opcache.huge_code_pages (7.0), and 5.6 has no JIT; [MySQL] for the
@comment module mysql (php56-mysql), mysql.allow_persistent = Off and
@comment mysql.default_socket, the socket of the other MySQL modules. OPcache
@comment is on for the CLI too (opcache.enable_cli = 1: aZ, for every version).
@comment opcache.max_accelerated_files stays 300000: the limit of PHP 5.6 is
@comment 1000000 (since PHP 5.5.6, NEWS: "Increased limit for
@comment opcache.max_accelerated_files to 1,000,000"; MAX_ACCEL_FILES of
@comment ext/opcache/zend_accelerator_module.c of the tarball), not 100000.
@comment Every other line holds in 5.6 as in 7.4 (session.use_strict_mode since
@comment 5.5.2, opcache.enable_file_override in the OPcache of 5.6;
@comment error_reporting is that of the php.ini-production of 5.6). Lines that
@comment begin with @comment are not in the file (SUB_FILES drops them).

; --- az: defaults of PHP 5.6, on top of php.ini-production above ---
[PHP]
expose_php = Off
short_open_tag = On
output_buffering = Off
memory_limit = 1024M
max_execution_time = 1800
max_input_time = 1800
max_input_vars = 10000
error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT
display_errors = Off
display_startup_errors = Off
html_errors = Off
log_errors = On
error_log = /var/log/php%%PHP_VER%%_error.log
allow_url_include = Off
upload_max_filesize = 500M
post_max_size = 512M
cgi.fix_pathinfo = 0
date.timezone = UTC
realpath_cache_size = 4096K
realpath_cache_ttl = 600
zlib.output_compression = Off

[Pdo_mysql]
pdo_mysql.default_socket = /tmp/mysql.sock

[MySQL]
mysql.allow_persistent = Off
mysql.default_socket = /tmp/mysql.sock

[MySQLi]
mysqli.default_socket = /tmp/mysql.sock

[Session]
session.save_handler = files
; redis (php56-redis, redis on its socket); with it gc_probability = 0
;session.save_handler = redis
;session.save_path = "unix:///var/run/redis/redis.sock"
;session.gc_probability = 0
session.use_strict_mode = 1
session.use_only_cookies = 1
session.cookie_httponly = 1
session.gc_probability = 1
session.gc_divisor = 1000

[opcache]
opcache.enable = 1
opcache.enable_cli = 1
opcache.memory_consumption = 2048
opcache.interned_strings_buffer = 256
opcache.max_accelerated_files = 300000
opcache.max_wasted_percentage = 10
opcache.validate_timestamps = 1
opcache.revalidate_freq = 2
opcache.enable_file_override = 1
