# The rules of the module ports of PHP 5.6: one slave port of lang/php56 per
# module, as the FreeBSD ports do it. A slave sets CATEGORIES, MASTERDIR and
# PKGNAMESUFFIX (-<module>; a PECL extension also DISTVERSION, its version) and
# includes the Makefile of lang/php56, which includes this file.
#
# Base: lang/php56/Makefile.ext of freebsd-ports d2c06ef5efae (the ports commit
# of PHP 5.6 in php-src freebsd/targets.conf), its slave ports (their files/)
# and the PECL ports of that commit, with the changes of this overlay as
# lang/php74/Makefile.ext has them (its head says what and why: the libraries
# of az, the options of php-src freebsd/ext.conf, USE_PHP, CONFLICTS_INSTALL,
# the ini of gmagick, the profiles), as lang/php81/Makefile.ext for 8.1:
# LIB_DEPENDS, USES and USE_GNOME of the libraries of the ports become AZ_LIBS
# and the directories of az; no --with-pcre-dir (the PCRE of the ports; the
# bundled PCRE of the fork is in the core); config0.m4 and config9.m4 as
# config.m4 by Mk/Uses/php.mk (not the post-extract of openssl, sqlite3 and
# zlib); the PHP_MOD_PRIO of opcache (10) and session (18) in
# Mk/php-modules.mk. Mk/Uses/php.mk is that of 036685c034ba for every version
# (for 5.6 lib/php/20131226 and pcre spl in the core, as the official); the
# php.mk of d2c06ef5efae is older, and of 5.6 alone it has only the modules
# mssql, mysql and sybase_ct of USE_PHP (mysql in Mk/php-modules.mk now) and
# libphp5.so (libphp56.so here). What 5.6 has otherwise:
# - the modules: ext.conf has the lines of 7.4 only (5.6 gets its lines when it
#   is worked out there), so they are those of 7.4 that PHP 5.6 has (not ffi
#   and sodium, of PHP 7.4 and 7.2; not excimer, swoole and openswoole, which
#   php-src freebsd/pecl.conf has not for 5.6), and of 5.6: hash (a module of
#   the official 5.6, a part of the core from PHP 7.4), mysql (--with-mysql=
#   mysqlnd, the line ext.conf announces for 5.6) and mcrypt (bundled in PHP
#   5.6: security/php56-mcrypt of the official tree, PECL mcrypt for 7.2 and
#   later). json is a module, as for 7.4; xmlrpc too.
# - the PECL extensions are those of ext/<name> of the 5.6 tarball, their
#   versions those of php-src freebsd/pecl.conf for 5.6 (igbinary 2.0.8,
#   memcache 3.0.8, memcached 2.2.0, redis 4.3.0, imagick 3.8.1, gmagick
#   1.1.7RC3); package php56-<name>, origin <category>/php56-<name>, as every
#   module (Mk/php-modules.mk). Their rules: converters/pecl-igbinary,
#   databases/pecl-memcache, databases/pecl-memcached2 (memcached 2 for PHP 5),
#   databases/pecl-redis and graphics/pecl-imagick of d2c06ef5efae; gmagick of
#   graphics/pecl-gmagick of 57eddb3fa57f (30.12.2018), as for 7.4: the last
#   commit that has it, its version 1.1.7RC3 for PHP 5.6. Not their DEPRECATED
#   and EXPIRATION_DATE (the fork carries the security backports, as for the
#   core) nor PORTSCOUT (of the official tree). intl: the rules of
#   devel/pecl-intl of d2c06ef5efae (the official 5.6 has no php56-intl), built
#   from ext/intl of the tarball (bundled in PHP 5.6), with the version, the
#   COMMENT, the LICENSE (PHP301, of lang/php56) and the CPE of PHP as the
#   bundled modules.
# - the patches of the official slaves (files/) as they are, but config.m4 of
#   fileinfo, filter, mbstring, phar and simplexml (only for the PCRE of the
#   ports: --with-pcre-dir, the bundled PCRE of the fork is in the core; that
#   of phar also sets PHP_HASH=yes for a check that PHP_HASH, empty under
#   phpize, passes anyway), readline_cli.c of readline (in the source already:
#   it includes config.h first) and patch-openssl11 of openssl (in the source
#   already: the branch of Remi Collet builds with OpenSSL 1.1 and the fork with
#   OpenSSL 3). The slaves are those of d2c06ef5efae with a pkg-descr (the
#   official slaves of 2019 took that of lang/php56).
# - ours, for the libraries of az and for building alone (phpize): the patch
#   of intl for ICU 70 and later (files/patch-icu70), that of tidy for
#   tidy-html5 (tidybuffio.h), that of imagick for its m4 path (as for 7.4),
#   that of mysqlnd for its include of its own header; see their rules.
# - libxml2 by xml2-config, which PHP 5.6 takes (PHP_SETUP_LIBXML): that of az
#   without the -L/lib of its --libs (AZ_XML2_CONFIG of lang/php56/Makefile:
#   the run path of a module is ${AZ_PREFIX}/lib only), for dom, simplexml,
#   soap, xml, xmlreader, xmlrpc, xmlwriter and xsl.
# - not TEST_TARGET: the official 5.6 has none.
# - gd with the bundled libgd of PHP 5.6 (the official 5.6 and the static build
#   of 5.6 of php-src: --with-gd), with FreeType, PNG and JPEG of az, not the
#   libgd of az of 7.4 (--with-external-gd is of PHP 7.4); see its rules. Its
#   options are set before bsd.port.pre.mk (after it in the official 5.6):
#   USES=xorg of X11 is read there in the framework of f16b6dd.
# - openssl: not the BROKEN with openssl111 of the official port (the fork
#   builds with OpenSSL 1.1 and 3; OpenSSL of the base system here).
# - IGNORE_WITH_PHP that of the official lang/php56.
#
# The modules, by the priority of their ini (ext-<NN>-<module>.ini): opcache
# 10 (a Zend extension), session 18, 20: bcmath bz2 calendar ctype curl dba dom
# exif fileinfo filter ftp gd gettext gmp hash iconv intl json mbstring mcrypt
# mysqlnd openssl openssl-legacy pcntl pdo posix readline shmop simplexml soap
# sockets sqlite3 sysvmsg sysvsem sysvshm tidy tokenizer xml xmlwriter zip zlib
# gmagick imagick; 30: mysql mysqli pdo_mysql pdo_sqlite phar xmlreader xmlrpc
# xsl igbinary memcache memcached redis.
#
# Not built, as for 7.4: enchant, imap, ldap, odbc, pdo_dblib, pdo_firebird,
# pdo_odbc, pdo_pgsql, pgsql, pspell, snmp, and of 5.6 interbase, mssql,
# recode and sybase_ct (a library of the ports: firebird, freetds, recode);
# wddx neither, which needs none (libxml2): it is not in the modules of 7.4 of
# ext.conf (removed from PHP 7.4) nor in the static build of 5.6 of php-src.

COMMENT=	The ${PHP_MODNAME} shared extension for php

USES+=	php:ext,noflavors
# openssl-legacy builds ext/openssl
PHP_MODNAME=	${PKGNAMESUFFIX:S/-//:S/-legacy$//}
PHP_VER=	56
IGNORE_WITH_PHP=	71 72 73

EXTSUBDIR=	${DISTNAME}/ext/${PHP_MODNAME}
WRKSRC=		${WRKDIR}/${EXTSUBDIR}
PATCHDIR=	${.CURDIR}/files
PLIST=		${NONEXISTENT}
# Each module port has a description of its own (not that of the core)
DESCR=		${.CURDIR}/pkg-descr

EXTRACT_AFTER_ARGS?=	${EXTSUBDIR}

# AZ_LIBS (per module): the libraries of ${AZ_PREFIX}/lib the module links
# (Mk/Uses/php.mk links them with their run path, found by the pkg-config of az)
BUILD_DEPENDS+=	${AZ_LIBS:@l@${AZ_PREFIX}/lib/${l}:az/az@}
RUN_DEPENDS+=	${AZ_LIBS:@l@${AZ_PREFIX}/lib/${l}:az/az@}

# the modules of libxml2: xml2-config of az without -L/lib (AZ_XML2_CONFIG)
AZ_XML2_MODULES=	dom simplexml soap xml xmlreader xmlrpc xmlwriter xsl
.if !empty(AZ_XML2_MODULES:M${PHP_MODNAME})
CONFIGURE_ENV+=	ac_cv_php_xml2_config_path=${AZ_XML2_CONFIG}
.endif

.if ${PHP_MODNAME} == "bcmath"
CONFIGURE_ARGS+=--enable-bcmath

PHP_HEADER_DIRS=libbcmath libbcmath/src
.endif

.if ${PHP_MODNAME} == "bz2"
CONFIGURE_ARGS+=--with-bz2=/usr
.endif

.if ${PHP_MODNAME} == "calendar"
CONFIGURE_ARGS+=--enable-calendar
.endif

.if ${PHP_MODNAME} == "ctype"
CONFIGURE_ARGS+=--enable-ctype
.endif

.if ${PHP_MODNAME} == "curl"
# libcurl of az (its curl-config)
AZ_LIBS=	libcurl.so

CONFIGURE_ARGS+=--with-curl=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "dba"
CONFIGURE_ARGS+=--enable-dba

OPTIONS_DEFINE=	CDB DB4 GDBM QDBM TOKYO INIFILE FLATFILE
OPTIONS_DEFAULT=CDB INIFILE FLATFILE

CDB_DESC=	cdb database support
DB4_DESC=	Berkeley DB4 support
GDBM_DESC=	GDBM database support
QDBM_DESC=	QDBM database support
TOKYO_DESC=	Tokyo Cabinet database support
INIFILE_DESC=	INI file support
FLATFILE_DESC=	flatfile support

PHP_HEADER_DIRS=	libcdb libflatfile libinifile
.endif

.if ${PHP_MODNAME} == "dom"
AZ_LIBS=	libxml2.so

CONFIGURE_ARGS+=--enable-dom \
		--with-libxml-dir=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "exif"
CONFIGURE_ARGS+=--enable-exif
.endif

.if ${PHP_MODNAME} == "fileinfo"
CONFIGURE_ARGS+=--enable-fileinfo

PHP_HEADER_DIRS=	libmagic
.endif

.if ${PHP_MODNAME} == "filter"
CONFIGURE_ARGS+=--enable-filter
.endif

.if ${PHP_MODNAME} == "ftp"
CONFIGURE_ARGS+=--enable-ftp \
		--with-openssl-dir=${OPENSSLBASE}

LDFLAGS+=	-L${OPENSSLLIB} -lcrypto -lssl
USES+=		ssl
.endif

.if ${PHP_MODNAME} == "gd"
# The bundled libgd of PHP 5.6 (as the official port), with FreeType, PNG and
# JPEG (mozjpeg) of az; FreeType by its pkg-config, that of az (az has no
# freetype-config: compat-freetype-pkgconfig of the fork)
AZ_LIBS=	libfreetype.so libjpeg.so libpng16.so

CONFIGURE_ARGS+=--with-gd \
		--with-freetype-dir=${AZ_PREFIX} \
		--with-jpeg-dir=${AZ_PREFIX} \
		--with-png-dir=${AZ_PREFIX} \
		--with-zlib-dir=/usr

USES+=		pkgconfig

# T1LIB, X11 (on in the port) and VPX need a library of the ports (t1lib,
# libXpm, libvpx; X11 is in the OPTIONS_UNSET of aZ too): off
OPTIONS_DEFINE=	T1LIB TRUETYPE JIS X11 VPX
OPTIONS_DEFAULT=TRUETYPE

T1LIB_DESC=	Include T1lib support
TRUETYPE_DESC=	Enable TrueType string function
JIS_DESC=	Enable JIS-mapped Japanese font support
X11_DESC=	Enable XPM support
VPX_DESC=	Enable VP8 codec support

PHP_HEADER_DIRS=libgd
.endif

.if ${PHP_MODNAME} == "gettext"
AZ_LIBS=	libintl.so
CONFIGURE_ARGS+=--with-gettext=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "gmp"
AZ_LIBS=	libgmp.so

CONFIGURE_ARGS+=--with-gmp=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "hash"
CONFIGURE_ARGS+=--enable-hash \
		--with-mhash
.endif

.if ${PHP_MODNAME} == "iconv"
# GNU libiconv of az, as ext.conf
AZ_LIBS=	libiconv.so
CONFIGURE_ARGS+=--with-iconv=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "intl"
# devel/pecl-intl of d2c06ef5efae (the intl of PHP 5.6 in the official tree;
# not its DEPRECATED and EXPIRATION_DATE, its COMMENT and LICENSE those of the
# bundled modules) with ICU 76 of az (its icu-config): C++17 for ICU 75 and
# later (the port: compiler:c++11-lib and USE_CXXSTD=gnu++11, which ICU 76
# refuses), so -Wno-register for the headers of PHP 5.6 (register, an error
# of clang in C++17); U_DEFINE_FALSE_AND_TRUE for the TRUE and FALSE of the
# sources of 5.6, which ICU 68 and later define only on request;
# files/patch-icu70
AZ_LIBS=	libicui18n.so

CONFIGURE_ARGS+=--enable-intl \
		--with-icu-dir=${AZ_PREFIX}

USES+=		compiler:c++17-lang

CPPFLAGS+=	-DU_USING_ICU_NAMESPACE=1 \
		-DU_DEFINE_FALSE_AND_TRUE=1
CXXFLAGS+=	-Wno-register
.endif

.if ${PHP_MODNAME} == "json"
CONFIGURE_ARGS+=--enable-json
.endif

.if ${PHP_MODNAME} == "mbstring"

CONFIGURE_ARGS+=--enable-mbstring

OPTIONS_DEFINE=	REGEX
OPTIONS_DEFAULT=REGEX

REGEX_DESC=	Enable multibyte regex support

PHP_HEADER_DIRS=libmbfl libmbfl/filters libmbfl/mbfl libmbfl/nls
.endif

.if ${PHP_MODNAME} == "mcrypt"
# libmcrypt of az, without libltdl
AZ_LIBS=	libmcrypt.so

CONFIGURE_ARGS+=--with-mcrypt=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "mysql"
# --with-mysql-sock where config.m4 has it (ext.conf: only for mysqli in 7.4;
# in 5.6 the option of ext/mysql)
CONFIGURE_ARGS+=--with-mysql-sock=/tmp/mysql.sock

OPTIONS_DEFINE=	MYSQLND
OPTIONS_DEFAULT=MYSQLND

MYSQLND_DESC=	Use MySQL Native Driver
.endif

.if ${PHP_MODNAME} == "mysqli"
OPTIONS_DEFINE=	MYSQLND
OPTIONS_DEFAULT=MYSQLND

MYSQLND_DESC=	Use MySQL Native Driver
.endif

.if ${PHP_MODNAME} == "mysqlnd"
# Ours: the MySQL Native Driver of mysql, mysqli and pdo_mysql (aZ: mysqlnd for
# the databases, never libmysqlclient of the ports; a part of the core in the
# official lang/php56). Its config9.m4 of 5.6 is for the core of php-src:
# - SSL: it runs PHP_SETUP_OPENSSL unless PHP_OPENSSL_DIR is "no" and has no
#   option for it (that of ext/openssl or ext/ftp in php-src), so configure
#   stops without it: the OpenSSL of the base system by the variable;
# - the compressed protocol: mysqlnd.h takes it with HAVE_ZLIB, which ext/zlib
#   of php-src defines and a module alone has not: defined here;
# - its libraries: PHP_SETUP_OPENSSL adds libssl and libcrypto to
#   MYSQLND_SHARED_LIBADD, which config9.m4 never substitutes, and it adds no
#   libz, so mysqlnd.so would need them (RSA_public_encrypt for the sha256 and
#   caching_sha2 logins, compress) without linking them: libssl, libcrypto and
#   libz of the base system by LDFLAGS, as the official ftp takes OpenSSL.
CONFIGURE_ARGS+=--enable-mysqlnd

CONFIGURE_ENV+=	PHP_OPENSSL_DIR=${OPENSSLBASE}
CPPFLAGS+=	-DHAVE_ZLIB=1
LDFLAGS+=	-L${OPENSSLLIB} -lcrypto -lssl -lz
USES+=		ssl
.endif

.if ${PHP_MODNAME} == "openssl"
CONFIGURE_ARGS+=--with-openssl=${OPENSSLBASE}

LDFLAGS+=	-L${OPENSSLLIB} -lcrypto -lssl
USES+=	ssl
.  if ${PKGNAMESUFFIX} == "-openssl-legacy"
# Ours: the legacy provider of OpenSSL loaded too (RC4, Blowfish, DES, CAST5,
# MD4; aZ's sites need RC4); the same files as php56-openssl
COMMENT=	The openssl shared extension for php, with the legacy provider
CONFIGURE_ARGS+=	--with-openssl-legacy-provider
CONFLICTS_INSTALL=	php${PHP_VER}-openssl
.  else
CONFLICTS_INSTALL=	php${PHP_VER}-openssl-legacy
.  endif
.endif

.if ${PHP_MODNAME} == "opcache"
CONFIGURE_ARGS+=--enable-opcache
.endif

.if ${PHP_MODNAME} == "pcntl"
CONFIGURE_ARGS+=--enable-pcntl
.endif

.if ${PHP_MODNAME} == "pdo"
CONFIGURE_ARGS+=--enable-pdo
.endif

.if ${PHP_MODNAME} == "pdo_mysql"
OPTIONS_DEFINE=	MYSQLND
OPTIONS_DEFAULT=MYSQLND

MYSQLND_DESC=	Use MySQL Native Driver

USE_PHP=	pdo:build
.endif

.if ${PHP_MODNAME} == "pdo_sqlite"
AZ_LIBS=	libsqlite3.so
CONFIGURE_ARGS+=--with-pdo-sqlite=${AZ_PREFIX}

USE_PHP=	pdo:build
.endif

# the headers of pdo for its drivers: PHP_CHECK_PDO_INCLUDES of PHP 5.6
# (acinclude.m4, for phpize too) looks for them in ${prefix}/include/php only,
# the layout of the official port (from PHP 7.0 in the include directory of
# phpize), so configure stops with "Cannot find php_pdo_driver.h." here: those
# of php56-pdo by its cache variable
.if ${PHP_MODNAME} == "pdo_mysql" || ${PHP_MODNAME} == "pdo_sqlite"
CONFIGURE_ENV+=	pdo_cv_inc_path=${PHPBASE}/include/php${PHP_VER}/php/ext
.endif

.if ${PHP_MODNAME} == "phar"
CONFIGURE_ARGS+=--enable-phar

USE_PHP=	hash:build
.endif

.if ${PHP_MODNAME} == "posix"
CONFIGURE_ARGS+=--enable-posix
.endif

.if ${PHP_MODNAME} == "readline"
# GNU readline of az (files/patch-config.m4 of the port: --with-readline under
# phpize, where --with-libedit is on too)
AZ_LIBS=	libreadline.so
CONFIGURE_ARGS+=--with-readline=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "session"
CONFIGURE_ARGS+=--enable-session
.endif

.if ${PHP_MODNAME} == "shmop"
CONFIGURE_ARGS+=--enable-shmop
.endif

.if ${PHP_MODNAME} == "simplexml"
AZ_LIBS=	libxml2.so
CONFIGURE_ARGS+=--enable-simplexml \
		--with-libxml-dir=${AZ_PREFIX}

USES+=		pkgconfig
.endif

.if ${PHP_MODNAME} == "soap"
AZ_LIBS=	libxml2.so
CONFIGURE_ARGS+=--enable-soap \
		--with-libxml-dir=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "sockets"
CONFIGURE_ARGS+=--enable-sockets
.endif

.if ${PHP_MODNAME} == "sqlite3"
AZ_LIBS=	libsqlite3.so
CONFIGURE_ARGS+=--with-sqlite3=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "sysvmsg"
CONFIGURE_ARGS+=--enable-sysvmsg
.endif

.if ${PHP_MODNAME} == "sysvsem"
CONFIGURE_ARGS+=--enable-sysvsem
.endif

.if ${PHP_MODNAME} == "sysvshm"
CONFIGURE_ARGS+=--enable-sysvshm
.endif

.if ${PHP_MODNAME} == "tidy"
# tidy-html5 of az (the libtidy of www/tidy-html5; the official port took
# www/tidy-lib, the tidy of 2009): files/patch-tidybuffio, its header
CONFIGURE_ARGS+=--with-tidy=${AZ_PREFIX}

AZ_LIBS=	libtidy.so
.endif

.if ${PHP_MODNAME} == "tokenizer"
CONFIGURE_ARGS+=--enable-tokenizer
.endif

.if ${PHP_MODNAME} == "xml"
AZ_LIBS=	libxml2.so
CONFIGURE_ARGS+=--enable-xml \
		--with-libxml-dir=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "xmlreader"
AZ_LIBS=	libxml2.so
CONFIGURE_ARGS+=--enable-xmlreader \
		--with-libxml-dir=${AZ_PREFIX}

USE_PHP=	dom:build
.endif

.if ${PHP_MODNAME} == "xmlrpc"
# libxml2 and GNU libiconv of az
AZ_LIBS=	libxml2.so libiconv.so
CONFIGURE_ARGS+=--with-xmlrpc \
		--with-libxml-dir=${AZ_PREFIX} \
		--with-iconv-dir=${AZ_PREFIX}

PHP_HEADER_DIRS=libxmlrpc

USE_PHP=	xml:build
.endif

.if ${PHP_MODNAME} == "xmlwriter"
AZ_LIBS=	libxml2.so
CONFIGURE_ARGS+=--enable-xmlwriter \
                --with-libxml-dir=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "xsl"
# libxslt and libexslt of az (its xslt-config)
AZ_LIBS=	libxslt.so libexslt.so
CONFIGURE_ARGS+=--with-xsl=${AZ_PREFIX}

USE_PHP=	dom:build xml:build
.endif

.if ${PHP_MODNAME} == "zip"
# libzip of az, not the one bundled in ext/zip
AZ_LIBS=	libzip.so

CONFIGURE_ARGS+=--enable-zip \
		--with-zlib-dir=/usr \
		--with-libzip=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "zlib"
CONFIGURE_ARGS+=--with-zlib=/usr
.endif

# The PECL extensions (the rules of their ports)

.if ${PHP_MODNAME} == "gmagick"
# graphics/pecl-gmagick of 57eddb3fa57f (1.1.7RC3, for PHP 5.6): GraphicsMagick
# of the overlay in ${AZ_PREFIX} (its libraries and GraphicsMagick-config,
# which config.m4 runs), not LIB_DEPENDS of the port; not its DEPRECATED and
# EXPIRATION_DATE. Not with imagick in one PHP: its ini comes off, and the CLI
# profile gmagick has it on and imagick off (aZ).
COMMENT=	Provides a wrapper to the GraphicsMagick library
WWW=		https://pecl.php.net/package/gmagick

LICENSE=	PHP301

AZ_GMAGICK_DEP=	${AZ_PREFIX}/lib/libGraphicsMagickWand.so:graphics/GraphicsMagick
BUILD_DEPENDS+=	${AZ_GMAGICK_DEP}
RUN_DEPENDS+=	${AZ_GMAGICK_DEP}

CONFIGURE_ARGS+=--with-gmagick=${AZ_PREFIX}

AZ_PROFILE=	${PREFIX}/etc/php${PHP_VER}-gmagick
AZ_INI_OFF=	"Off: imagick and gmagick must not be loaded into one PHP" \
		"(GraphicsMagick and ImageMagick have the same function names):" \
		"gmagick is on in the CLI profile gmagick, ${AZ_PROFILE}" \
		"(pkg info -D ${PKGBASE})."
AZ_MSG=		"imagick and gmagick must not be loaded into one PHP: GraphicsMagick" \
		"and ImageMagick have the same MagickWand function names, so one" \
		"module could call the library of the other. One of the two per" \
		"php.ini or profile, so ${AZ_INI}" \
		"comes with its line commented out, and the CLI profile gmagick," \
		"${AZ_PROFILE}, has gmagick on and imagick off, with" \
		"the other modules of ${AZ_INI:H} (it follows them; made at the" \
		"first installation by php${PHP_VER}-profile --create gmagick --follow" \
		"--off imagick --on gmagick --cli). Run a script with it:" \
		"  php${PHP_VER}-profile gmagick script.php" \
		"The profile stays when ${PKGBASE} is removed; to remove it:" \
		"  rm -r ${AZ_PROFILE}" \
		"To load gmagick in ${AZ_INI:H} instead of imagick:" \
		"comment out the line of imagick in ext-*-imagick.ini there, remove" \
		"the ';' before extension=gmagick.so in ${AZ_INI:T}, then" \
		"restart php_fpm${PHP_VER} or Apache."
AZ_MSG_REMOVE=	"The CLI profile gmagick, ${AZ_PROFILE}, stays; to" \
		"remove it: rm -r ${AZ_PROFILE}"
.endif

.if ${PHP_MODNAME} == "igbinary"
# converters/pecl-igbinary of d2c06ef5efae (2.0.8, the version here)
COMMENT=	Replacement for the standard PHP serializer
WWW=		https://pecl.php.net/package/igbinary

LICENSE=	BSD3CLAUSE
LICENSE_FILE=	${WRKSRC}/COPYING

CONFIGURE_ARGS+=--enable-igbinary
# Its session serializer
USE_PHP=	session:build
.endif

.if ${PHP_MODNAME} == "imagick"
# graphics/pecl-imagick of d2c06ef5efae (3.4.3 with ImageMagick 6 there, its
# option X11 the flavor of ImageMagick6): ImageMagick 7 of the overlay in
# ${AZ_PREFIX} (libraries, MagickWand-config) with its configuration in
# ${LOCALBASE}/etc/ImageMagick-7, as for 7.4: ImageMagick6 of the overlay has
# its programs only (static), no libraries for modules; so not the option X11;
# not USES=localbase (no library of the ports)
COMMENT=	Provides a wrapper to the ImageMagick/GraphicsMagick library
WWW=		https://pecl.php.net/package/imagick

LICENSE=	PHP301

BUILD_DEPENDS+=	${AZ_PREFIX}/lib/libMagickWand-7.so:graphics/ImageMagick7
RUN_DEPENDS+=	${AZ_PREFIX}/lib/libMagickWand-7.so:graphics/ImageMagick7

USES+=		pkgconfig

CONFIGURE_ARGS+=--with-imagick=${AZ_PREFIX}
.endif

.if ${PHP_MODNAME} == "memcache"
# databases/pecl-memcache of d2c06ef5efae (3.0.8, the version here): not its
# DEPRECATED and EXPIRATION_DATE; not its USES=dos2unix (ext/memcache of the
# tarball has no CRLF line ends, and no patch of the port is applied here); not
# its option EXAMPLES (example.php; EXAMPLES is in the OPTIONS_UNSET of aZ)
COMMENT=	Memcached extension for PHP 5.6
WWW=		https://pecl.php.net/package/memcache

LICENSE=	PHP30
LICENSE_FILE=	${WRKSRC}/LICENSE

USE_CSTD=	gnu89
USE_PHP=	session:build zlib:build

CONFIGURE_ARGS+=--enable-memcache \
		--with-zlib-dir=/usr
.endif

.if ${PHP_MODNAME} == "memcached"
# databases/pecl-memcached2 of d2c06ef5efae (2.2.0, the version here):
# libmemcached of az, found by its pkg-config (that of az); not its DEPRECATED,
# EXPIRATION_DATE and PORTSCOUT; the options of ext.conf: IGBINARY on, SASL off
# (cyrus-sasl2 of the ports; the libmemcached of az has no SASL either);
# USE_PHP=json of the port (it does not pass --enable-memcached-json, nor here)
COMMENT=	PHP extension for interfacing with memcached via libmemcached library
WWW=		https://pecl.php.net/package/memcached \
		https://github.com/php-memcached-dev/php-memcached

LICENSE=	PHP30
LICENSE_FILE=	${WRKSRC}/LICENSE

AZ_LIBS=	libmemcached.so

USES+=		pkgconfig
USE_PHP=	json:build session:build

CONFIGURE_ARGS+=--enable-memcached \
		--with-libmemcached-dir=${AZ_PREFIX} \
		--with-zlib-dir=/usr

OPTIONS_DEFINE=	IGBINARY SASL
OPTIONS_DEFAULT=IGBINARY
IGBINARY_DESC=	Binary serializer support

IGBINARY_CONFIGURE_ENABLE=	memcached-igbinary
IGBINARY_USE=		PHP=igbinary:build
SASL_CONFIGURE_ENABLE=	memcached-sasl
SASL_LIB_DEPENDS=	libsasl2.so:security/cyrus-sasl2
.endif

.if ${PHP_MODNAME} == "redis"
# databases/pecl-redis of d2c06ef5efae (4.2.0 there): IGBINARY on (ext.conf);
# not its CONFLICTS_INSTALL of pecl-redis3, a package that is not ours. Ours:
# hash in USE_PHP too, a module of 5.6 (the core has it from 7.4):
# redis_array_impl.c includes ext/hash/php_hash.h and calls
# php_hash_fetch_ops() (RedisArray with the option algorithm), so the build
# needs its headers and redis.so its symbol (without hash.so the call ends PHP:
# symbol lookup error)
COMMENT=	Extension to access Redis
WWW=		https://pecl.php.net/package/redis

LICENSE=	PHP301
LICENSE_FILE=	${WRKSRC}/COPYING

USE_PHP=	hash:build session:build

CONFIGURE_ARGS+=--enable-redis

OPTIONS_DEFINE=	IGBINARY
OPTIONS_DEFAULT=IGBINARY
IGBINARY_DESC=	Build with Igbinary serializer

IGBINARY_CONFIGURE_ENABLE=	redis-igbinary
IGBINARY_USE=			php=igbinary:build
.endif

# The CPE of a PECL extension is that of its port: USES=cpe and CPE_PRODUCT=php
# of lang/php56 (the CPE of PHP, which the bundled modules have, as in the
# official tree) would make it cpe:2.3:a:php:php:<its version>; the ports of
# these have no CPE at their commits, so they have none here either
AZ_NO_CPE=	gmagick igbinary imagick memcache memcached redis
.if !empty(AZ_NO_CPE:M${PHP_MODNAME})
USES:=		${USES:Ncpe}
.endif

.include <bsd.port.options.mk>

.if ${PHP_MODNAME} == "dba"
.	if empty(PORT_OPTIONS:MCDB)
CONFIGURE_ARGS+=--without-cdb
.	endif
.	if ${PORT_OPTIONS:MDB4}
CONFIGURE_ARGS+=--with-db4=${LOCALBASE}

USES+=			bdb
WITH_BDB_HIGHEST=	yes
.	endif
.	if ${PORT_OPTIONS:MGDBM}
LIB_DEPENDS+=	libgdbm.so:databases/gdbm

CONFIGURE_ARGS+=--with-gdbm=${LOCALBASE}
.	endif
.	if ${PORT_OPTIONS:MQDBM}
LIB_DEPENDS+=	libqdbm.so:databases/qdbm

CONFIGURE_ARGS+=--with-qdbm=${LOCALBASE}
.	endif
.	if ${PORT_OPTIONS:MTOKYO}
LIB_DEPENDS+=	libtokyocabinet.so:databases/tokyocabinet

CONFIGURE_ARGS+=--with-tcadb=${LOCALBASE}
.	endif
.	if empty(PORT_OPTIONS:MINIFILE)
CONFIGURE_ARGS+=--disable-inifile
.	endif
.	if empty(PORT_OPTIONS:MFLATFILE)
CONFIGURE_ARGS+=--disable-flatfile
.	endif
.endif

.if ${PHP_MODNAME} == "mysql"
.	if ${PORT_OPTIONS:MMYSQLND}
CONFIGURE_ARGS+=--with-mysql=mysqlnd
USE_PHP=	mysqlnd:build
.	else
CONFIGURE_ARGS+=--with-mysql=${LOCALBASE} \
		--with-zlib-dir=/usr

USES+=	mysql
.	endif
.endif

.if ${PHP_MODNAME} == "mysqli"
.	if ${PORT_OPTIONS:MMYSQLND}
CONFIGURE_ARGS+=--with-mysqli=mysqlnd
USE_PHP=	mysqlnd:build
.	else
CONFIGURE_ARGS+=--with-mysqli=${LOCALBASE}/bin/mysql_config

USES+=	mysql
.	endif
.endif

.if ${PHP_MODNAME} == "pdo_mysql"
.	if ${PORT_OPTIONS:MMYSQLND}
CONFIGURE_ARGS+=--with-pdo-mysql=mysqlnd

USE_PHP+=	mysql mysqlnd:build
.	else
CONFIGURE_ARGS+=--with-pdo-mysql=${LOCALBASE} \
		--with-zlib-dir=/usr

USES+=	mysql
.	endif
.endif

# (before bsd.port.pre.mk, unlike the official 5.6: USES=xorg of X11 is read
# there in the framework of f16b6dd, as for 7.4)
.if ${PHP_MODNAME} == "gd"
.	if ${PORT_OPTIONS:MT1LIB}
LIB_DEPENDS+=	libt1.so:devel/t1lib

CONFIGURE_ARGS+=--with-t1lib=${LOCALBASE}
.	endif
.	if ${PORT_OPTIONS:MTRUETYPE}
CONFIGURE_ARGS+=--enable-gd-native-ttf
.	endif
.	if ${PORT_OPTIONS:MJIS}
CONFIGURE_ARGS+=--enable-gd-jis-conv
.	endif
.	if ${PORT_OPTIONS:MX11}
USES+=		xorg
USE_XORG=	x11 xpm

CONFIGURE_ARGS+=--with-xpm-dir=${LOCALBASE}
.	endif
.	if ${PORT_OPTIONS:MVPX}
LIB_DEPENDS+=	libvpx.so:multimedia/libvpx

CONFIGURE_ARGS+=--with-vpx-dir=${LOCALBASE}
.	endif
.endif

.include <bsd.port.pre.mk>

.if ${PHP_MODNAME} == "mbstring"
.	if ${PORT_OPTIONS:MREGEX}
# oniguruma of az (the official: devel/oniguruma; files/patch-php__mbregex.c
# for its API of 6.x)
AZ_LIBS+=	libonig.so
CONFIGURE_ARGS+=--with-onig=${AZ_PREFIX}
.	else
CONFIGURE_ARGS+=--disable-mbregex
.	endif
.endif

.if ${PHP_MODNAME} == "xml"
post-extract:
	@${MKDIR} ${WRKSRC}/ext/xml
	@${CP} ${WRKSRC}/expat_compat.h ${WRKSRC}/ext/xml
.endif

.if ${PHP_MODNAME} == "igbinary"
post-patch:
	@${CP} ${WRKSRC}/src/php${PHP_VER:C|.$||}/igbinary.h ${WRKSRC}/igbinary.h
	@${CP} ${WRKSRC}/src/php${PHP_VER:C|.$||}/php_igbinary.h ${WRKSRC}/php_igbinary.h
.endif

# xml2-config of az without -L/lib (AZ_XML2_CONFIG of lang/php56/Makefile)
.if !empty(AZ_XML2_MODULES:M${PHP_MODNAME})
pre-configure:
	@${PRINTF} '%s\n' '#!/bin/sh' \
		'${AZ_PREFIX}/bin/xml2-config "$$@" | ${SED} -e "s|[[:space:]]-L/lib[[:space:]]| |g"' \
		> ${AZ_XML2_CONFIG}
	@${CHMOD} 755 ${AZ_XML2_CONFIG}
.endif

# The ini of the module installed (by ${PHP_EXT_INI_FILE}, an .ini.sample, and
# @sample in the plist): AZ_INI. AZ_INI_OFF (gmagick): the ini comes with its
# line commented out, after these lines of the reason; AZ_MSG: the message of
# the package (why, how to switch it on) in the place of that of
# Mk/Uses/php.mk (which says that the ini loads the module), and AZ_MSG_REMOVE
# one at its removal. Lines as words in double quotes, without '"' or '$'.
# The targets run after add-plist-phpext of php.mk, which staged the ini and
# wrote the message.
AZ_INI=		${PREFIX}/${PHP_EXT_INI_FILE:S/.sample$//}
.if defined(AZ_INI_OFF)
POST_PLIST+=	az-ini-off
az-ini-off:
	@${PRINTF} '; %s\n' ${AZ_INI_OFF} > ${STAGEDIR}${PREFIX}/${PHP_EXT_INI_FILE}
	@${ECHO_CMD} ";extension=${PHP_MODNAME}.so" \
		>> ${STAGEDIR}${PREFIX}/${PHP_EXT_INI_FILE}
	@${PRINTF} '%s\n' '[' '{' '  message: <<EOD' ${AZ_MSG} 'EOD' \
		'  type: install' > ${PHP_EXT_PKGMESSAGE}
.  if defined(AZ_MSG_REMOVE)
	@${PRINTF} '%s\n' '},' '{' '  message: <<EOD' ${AZ_MSG_REMOVE} 'EOD' \
		'  type: remove' >> ${PHP_EXT_PKGMESSAGE}
.  endif
	@${PRINTF} '%s\n' '}' ']' >> ${PHP_EXT_PKGMESSAGE}
.endif

# Every module package: php${PHP_VER}-profile of the core syncs the profiles
# that follow ${PREFIX}/etc/php${PHP_VER}/conf.d (their links to the ini of the
# modules) after its installation and after its removal (aZ, 08.11.2026);
# php${PHP_VER}-gmagick makes the CLI profile gmagick after its ini, unless it
# is there (it stays at the removal: the message says so).
# (no blank before a backslash: the lines are those of the plist, one blank)
AZ_PROFILE_SYNC=	[ -x %D/bin/php${PHP_VER}-profile ] &&\
			%D/bin/php${PHP_VER}-profile --sync > /dev/null 2>&1 || true
AZ_PROFILE_GMAGICK=	[ -d %D/etc/php${PHP_VER}-gmagick ] ||\
			%D/bin/php${PHP_VER}-profile --create gmagick --follow\
			--off imagick --on gmagick --cli
POST_PLIST+=	az-plist-profile
az-plist-profile:
	@${ECHO_CMD} "@postexec ${AZ_PROFILE_SYNC}" >> ${TMPPLIST}
	@${ECHO_CMD} "@postunexec ${AZ_PROFILE_SYNC}" >> ${TMPPLIST}
.if ${PHP_MODNAME} == "gmagick"
	@${ECHO_CMD} "@postexec ${AZ_PROFILE_GMAGICK}" >> ${TMPPLIST}
.endif
