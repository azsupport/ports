FFmpeg master 5647739dddb2 (2026-10-02), not in release/9.0 after 9.0.2:
https://github.com/FFmpeg/FFmpeg/commit/5647739dddb2679ebfe488d6745f0fa1f405bc5d

mov: update_frag_index() inserted a fragment before the current one without
moving frag_index.current, the next trun then wrote its samples at the position
of another fragment: out of array access on a crafted fragmented mp4.

--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -1917,6 +1917,8 @@ static int update_frag_index(MOVContext *c, int64_t offset)
     if (index < c->frag_index.nb_items)
         memmove(c->frag_index.item + index + 1, c->frag_index.item + index,
                 (c->frag_index.nb_items - index) * sizeof(*c->frag_index.item));
+    if (index <= c->frag_index.current)
+        c->frag_index.current++;
 
     item = &c->frag_index.item[index];
     item->headers_read = 0;
