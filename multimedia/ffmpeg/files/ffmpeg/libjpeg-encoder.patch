index 000000000..ce295548d
--- /dev/null
+++ b/libavcodec/libjpegenc.c
@@ -0,0 +1,253 @@
+/*
+ * JPEG encoder using libjpeg (libjpeg-turbo, mozjpeg, jpegli: any library with its API)
+ *
