FFmpeg release/9.0 after 9.0.2, commit 4cf298e66a20, from master 8319541103ae:
https://github.com/FFmpeg/FFmpeg/commit/4cf298e66a20dd90e8b7c62333ab5812596835ec

AAC (USAC, that is xHE-AAC): a channel element that che_configure() allocates
while a USAC frame is decoded had no output buffer, the IMDCT windowing then
wrote through a NULL pointer: ffmpeg crashes on a crafted upload.

--- a/libavcodec/aac/aacdec.c
+++ b/libavcodec/aac/aacdec.c
@@ -150,6 +150,8 @@ static av_cold int che_configure(AACDecContext *ac,
             int ret = ac->proc.sbr_ctx_alloc_init(ac, &ac->che[type][id], type);
             if (ret < 0)
                 return ret;
+            ac->che[type][id]->ch[0].output = ac->che[type][id]->ch[0].ret_buf;
+            ac->che[type][id]->ch[1].output = ac->che[type][id]->ch[1].ret_buf;
         }
         if (type != TYPE_CCE) {
             if (*channels >= MAX_CHANNELS - (type == TYPE_CPE || (type == TYPE_SCE && ac->oc[1].m4ac.ps == 1))) {
