FFmpeg master 82b7a19f4a18 (2026-10-11), not in release/9.0 after 9.0.2:
https://github.com/FFmpeg/FFmpeg/commit/82b7a19f4a18425dd17df4156062f8103da624f9

HEVC: clearing the SPS of a non-base layer also dropped the active VPS of the
base layer, the next base layer frame dereferenced the NULL VPS: a crash on a
crafted upload.

--- a/libavcodec/hevc/hevcdec.c
+++ b/libavcodec/hevc/hevcdec.c
@@ -764,7 +764,6 @@ static int set_sps(HEVCContext *s, HEVCLayerContext *l, const HEVCSPS *sps)
 
     pic_arrays_free(l);
     av_refstruct_unref(&l->sps);
-    av_refstruct_unref(&s->vps);
 
     if (!sps)
         return 0;
@@ -773,6 +772,8 @@ static int set_sps(HEVCContext *s, HEVCLayerContext *l, const HEVCSPS *sps)
     if (ret < 0)
         goto fail;
 
+    av_refstruct_unref(&s->vps);
+
     ff_hevc_pred_init(&s->hpc,     sps->bit_depth);
     ff_hevc_dsp_init (&s->hevcdsp, sps->bit_depth);
     ff_videodsp_init (&s->vdsp,    sps->bit_depth);
