                -57.75f + 0.25f * usac->loudness.input_method_val,
                usac->loudness.input_method_val);
 
+    usac->nb_elems = nb_elems;
     ret = ff_aac_usac_reset_state(ac, oc);
     if (ret < 0)
         return ret;
