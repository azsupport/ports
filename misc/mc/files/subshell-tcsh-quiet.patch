-        write_all (mc_global.tty.subshell_pty, "/", 1);
+        g_string_append_c (cd_cmd, '/');
     else
     {
         const char *translate;
 
         translate = vfs_translate_path (vfs_path_as_str (vpath));
         if (translate == NULL)
-            write_all (mc_global.tty.subshell_pty, ".", 1);
+            g_string_append_c (cd_cmd, '.');
         else
         {
             GString *temp;
 
             temp = subshell_name_quote (translate);
-            write_all (mc_global.tty.subshell_pty, temp->str, temp->len);
+            g_string_append_len (cd_cmd, temp->str, temp->len);
             g_string_free (temp, TRUE);
         }
     }
 
-    write_all (mc_global.tty.subshell_pty, "\n", 1);
+    /* tcsh: the cd from the file by the key, then an empty line for precmd and a new
+     * prompt (neither is recorded in the history) */
+    if (mc_global.shell->type != SHELL_TCSH || !tcsh_write_cmd_file (cd_cmd->str))
+    {
+        write_all (mc_global.tty.subshell_pty, cd_cmd->str, cd_cmd->len);
+        write_all (mc_global.tty.subshell_pty, "\n", 1);
+    }
+    else
+        write_all (mc_global.tty.subshell_pty, TCSH_CMD_KEY "\n", sizeof (TCSH_CMD_KEY "\n") - 1);
+    g_string_free (cd_cmd, TRUE);
 
     subshell_state = RUNNING_COMMAND;
     if (!feed_subshell (QUIETLY, TRUE))
