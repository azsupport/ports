-                    "set echo_style=both; "
-                    "alias precmd 'echo -n;echo $cwd:q >>%s; kill -STOP $$'\n", tcsh_fifo);
+                    "set echo_style=both; set edit; "
+                    "alias precmd 'echo -n;echo $cwd:q >>%s; kill -STOP $$'; "
+                    "bindkey -c '" TCSH_CMD_KEY_BINDKEY "' 'source %s'; "
+                    "history -c; history -L\n", tcsh_fifo, tcsh_cmd_file);
         break;
     case SHELL_FISH:
         g_snprintf (precmd, buff_size,
@@ -1383,10 +1393,31 @@ clear_cwd_pipe (void)
 
 /* --------------------------------------------------------------------------------------------- */
 
+/* tcsh: the command mc runs by the key of bindkey -c into tcsh_cmd_file; FALSE when it
+ * could not be written (then it is typed as before) */
+static gboolean
+tcsh_write_cmd_file (const char *cmd)
+{
+    int fd;
+    size_t len;
+    gboolean ok;
+
+    fd = open (tcsh_cmd_file, O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW, 0600);
+    if (fd == -1)
+        return FALSE;
+    len = strlen (cmd);
+    ok = write_all (fd, cmd, len) == (ssize_t) len && write_all (fd, "\n", 1) == 1;
+    ok = close (fd) == 0 && ok;
+    return ok;
+}
+
+/* --------------------------------------------------------------------------------------------- */
+
