 /* tcsh closes all non-standard file descriptors, so we have to use a pipe */
 static char tcsh_fifo[128];
 
+/* tcsh has nothing like the ignorespace of bash and zsh, which keeps the commands mc sends
+ * out of the history: tcsh runs them from this file by a key bound with bindkey -c (the
+ * commands of a key binding are not recorded), and a history -c and -L in its init line
+ * takes that line out again */
+static char tcsh_cmd_file[128];
+#define TCSH_CMD_KEY_BINDKEY "^[(mcCD"
+#define TCSH_CMD_KEY ESC_STR "(mcCD"
+
 static int subshell_pty_slave = -1;
 
 /* The key for switching back to MC from the subshell */
@@ -1251,8 +1259,10 @@ init_subshell_precmd (char *precmd, size_t buff_size)
 
