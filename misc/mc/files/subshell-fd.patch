Description: the pipe of the subshell's working directory is made before its pty, so that its descriptor is more likely below 10, which the precmd of dash, ksh and mksh needs ("pwd >&N")
Origin: Debian, subshell-fd.patch of mc 3:4.8.33-1+deb13u1 (trixie, urgency high),
 https://sources.debian.org/src/mc/3%3A4.8.33-1%2Bdeb13u1/debian/patches/subshell-fd.patch;
 upstream https://github.com/MidnightCommander/mc/commit/421f652ef98c1cf232bf84abc06de5a5ffabc829 (19.06.2025, after 4.8.33;
 the same change, here on the code of 4.8.33)
Bug: https://bugs.debian.org/1108061, https://github.com/MidnightCommander/mc/issues/4634, https://github.com/MidnightCommander/mc/pull/4724
Why: POSIX shells redirect only descriptors 0 to 9; with the pipe at 10 or above the
 precmd of mc for dash, ksh and mksh fails: a syntax error, ten seconds at the
 start, "Pause after run" ignored. bash and zsh take any descriptor, tcsh uses a
 FIFO by name: no change for them.

--- src/subshell/common.c.orig
+++ src/subshell/common.c
@@ -1543,36 +1543,6 @@ init_subshell (void)
         if (mc_global.shell->type == SHELL_NONE)
             return;
 
-        /* Open a pty for talking to the subshell */
-
-        /* FIXME: We may need to open a fresh pty each time on SVR4 */
-
-#ifdef HAVE_OPENPTY
-        if (openpty (&mc_global.tty.subshell_pty, &subshell_pty_slave, NULL, NULL, NULL))
-        {
-            fprintf (stderr, "Cannot open master and slave sides of pty: %s\n",
-                     unix_error_string (errno));
-            mc_global.tty.use_subshell = FALSE;
-            return;
-        }
-#else
-        mc_global.tty.subshell_pty = pty_open_master (pty_name);
-        if (mc_global.tty.subshell_pty == -1)
-        {
-            fprintf (stderr, "Cannot open master side of pty: %s\r\n", unix_error_string (errno));
-            mc_global.tty.use_subshell = FALSE;
-            return;
-        }
-        subshell_pty_slave = pty_open_slave (pty_name);
-        if (subshell_pty_slave == -1)
-        {
-            fprintf (stderr, "Cannot open slave side of pty %s: %s\r\n",
-                     pty_name, unix_error_string (errno));
-            mc_global.tty.use_subshell = FALSE;
-            return;
-        }
-#endif /* HAVE_OPENPTY */
-
         /* Create a pipe for receiving the subshell's CWD */
 
         if (mc_global.shell->type == SHELL_TCSH)
@@ -1614,6 +1584,40 @@ init_subshell (void)
             mc_global.tty.use_subshell = FALSE;
             return;
         }
+
+        /* Open a pty for talking to the subshell; do this after
+         * acquiring the pipes, so the latter have a higher chance
+         * of getting a number lower than 10 so the "pwd >&%d" in
+         * the mc-injected precmd does not cause a syntax error, a
+         * ten-second sleep at startup, and other problems. */
+
+        /* FIXME: We may need to open a fresh pty each time on SVR4 */
+
+#ifdef HAVE_OPENPTY
+        if (openpty (&mc_global.tty.subshell_pty, &subshell_pty_slave, NULL, NULL, NULL))
+        {
+            fprintf (stderr, "Cannot open master and slave sides of pty: %s\n",
+                     unix_error_string (errno));
+            mc_global.tty.use_subshell = FALSE;
+            return;
+        }
+#else
+        mc_global.tty.subshell_pty = pty_open_master (pty_name);
+        if (mc_global.tty.subshell_pty == -1)
+        {
+            fprintf (stderr, "Cannot open master side of pty: %s\r\n", unix_error_string (errno));
+            mc_global.tty.use_subshell = FALSE;
+            return;
+        }
+        subshell_pty_slave = pty_open_slave (pty_name);
+        if (subshell_pty_slave == -1)
+        {
+            fprintf (stderr, "Cannot open slave side of pty %s: %s\r\n",
+                     pty_name, unix_error_string (errno));
+            mc_global.tty.use_subshell = FALSE;
+            return;
+        }
+#endif /* HAVE_OPENPTY */
     }
 
     /* Fork the subshell */
