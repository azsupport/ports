--- config/jvm.options.orig
+++ config/jvm.options
@@ -19,8 +19,14 @@
 # Xms represents the initial size of total heap space
 # Xmx represents the maximum size of total heap space
 
--Xms1g
--Xmx1g
+# azsupport/ports: one file for every server. Without elasticsearch_heap in
+# /etc/rc.conf the heap is 31g (aZ, 12.11.2026: below the cutoff of compressed
+# oops near 32 GB). On a server with less than 64 GB of RAM set
+# elasticsearch_heap="16g", at most half of the RAM (the rest is the cache of
+# the file system): the rc script passes it as -Xms and -Xmx after this file.
+
+-Xms31g
+-Xmx31g
 
 ################################################################
 ## Expert settings
@@ -46,6 +52,13 @@
 14-:-XX:+UseG1GC
 14-:-XX:G1ReservePercent=25
 14-:-XX:InitiatingHeapOccupancyPercent=30
+# azsupport/ports: the three lines above are those of 6.8.23 and stay: they are
+# what Elasticsearch 7.17, which Elastic ships with JDK 17 and later, runs with on
+# a heap of 8 GB and more (JvmErgonomics; IHOP 30 on any heap). For a heap below
+# 8 GB 7.10 and later choose -XX:G1HeapRegionSize=4m and -XX:G1ReservePercent=15
+# (elastic/elasticsearch#59667, measured on 7.x); on 6.8.23 with a heap of 1 GB
+# and of 4 GB a load of indexing and searches showed no fewer GC pauses with
+# them (11.11.2026), so they are not set here.
 
 ## DNS cache policy
 # cache ttl in seconds for positive DNS lookups noting that this overrides the
@@ -95,35 +108,58 @@
 
 -Djava.io.tmpdir=${ES_TMPDIR}
 
-## heap dumps
+## out of memory
 
-# generate a heap dump when an allocation from the Java heap fails
-# heap dumps are created in the working directory of the JVM
--XX:+HeapDumpOnOutOfMemoryError
-
-# specify an alternative path for heap dumps; ensure the directory exists and
-# has sufficient space
--XX:HeapDumpPath=data
+# azsupport/ports: no heap dump (aZ, 11.11.2026): the tarball has
+# -XX:+HeapDumpOnOutOfMemoryError and -XX:HeapDumpPath here, and a dump is a
+# file as large as the heap at every OutOfMemoryError.
+# Exit at an OutOfMemoryError, as 7.16 and later do (elastic/elasticsearch#71542:
+# "safer to use the JVM's built-in support for terminating the process on OOM"):
+# Elasticsearch 6.8 halts on it by itself (ElasticsearchUncaughtExceptionHandler),
+# unless some code caught the error; the flag makes it certain, and the bootstrap
+# checks of 6.8 name it as the one to use. A node that ran out of heap is not
+# left half alive in the cluster.
+9-:-XX:+ExitOnOutOfMemoryError
 
 # specify an alternative path for JVM fatal error logs
--XX:ErrorFile=logs/hs_err_pid%p.log
-
-## JDK 8 GC logging
-
-8:-XX:+PrintGCDetails
-8:-XX:+PrintGCDateStamps
-8:-XX:+PrintTenuringDistribution
-8:-XX:+PrintGCApplicationStoppedTime
-8:-Xloggc:logs/gc.log
-8:-XX:+UseGCLogFileRotation
-8:-XX:NumberOfGCLogFiles=32
-8:-XX:GCLogFileSize=64m
-
-# JDK 9+ GC logging
-9-:-Xlog:gc*,gc+age=trace,safepoint:file=logs/gc.log:utctime,pid,tags:filecount=32,filesize=64m
+# azsupport/ports: /var/log/elasticsearch, as the deb and rpm of Elastic (the
+# tarball has logs, relative to lib/elasticsearch); this file and the replay file
+# below stay: small text files, written only when the JVM itself crashes (without
+# these options the JVM would write them to its working directory or to /tmp)
+-XX:ErrorFile=/var/log/elasticsearch/hs_err_pid%p.log
+
+# azsupport/ports: the replay file of a JIT compiler that crashed next to it, as
+# 8.x sets it (SystemJvmOptions: -XX:ReplayDataFile, /var/log/elasticsearch in
+# the deb and rpm); the JVM writes it to its working directory otherwise
+-XX:ReplayDataFile=/var/log/elasticsearch/replay_pid%p.log
+
+## GC logging
+
+# azsupport/ports: no GC log (aZ, 11.11.2026: writes that were never of use): the
+# tarball has -Xloggc and its options for JDK 8 and -Xlog:gc*,gc+age=trace,
+# safepoint into the file gc.log (up to 32 files of 64 MB) for JDK 9 and later.
+# Elasticsearch itself still writes the collections that take long or come often
+# to its own log (JvmGcMonitorService: [gc][young], [gc][old], "overhead, spent").
+
+## the shared memory file of the JVM
+
+# azsupport/ports: no /tmp/hsperfdata_<user>/<pid>, the file of performance
+# counters that the JVM maps and keeps writing (aZ, 11.11.2026: nothing in /tmp).
+# The cost: jps, jstat and jcmd -l do not see the process; jcmd and jstack with
+# its process id still work.
+-XX:+PerfDisableSharedMem
 # due to internationalization enhancements in JDK 9 Elasticsearch need to set the provider to COMPAT otherwise
 # time/date parsing will break in an incompatible way for some date patterns and locals
+# azsupport/ports: stays as it is on JDK 17: COMPAT is there until JDK 23 and
+# JDK 17 says nothing about it; 7.17 on JDK 17 runs with SPI,COMPAT, where SPI is
+# for a class that 6.8 does not have (IsoCalendarDataProvider)
 9-:-Djava.locale.providers=COMPAT
 
 # temporary workaround for C2 bug with JDK 10 on hardware with AVX-512
-10-:-XX:UseAVX=2
+# azsupport/ports: for JDK 10 alone, not for 10 and later: the bug is fixed in
+# JDK 11, and Elastic took the line out of 7.1 and later for that reason
+# (elastic/elasticsearch#40828; it came with #32138). On JDK 17 it kept AVX-512
+# off where the CPU has it, and on a CPU without AVX2 the JVM printed "UseAVX=2
+# is not supported on this CPU, setting it to UseAVX=1" at every start
+# (src/hotspot/cpu/x86/vm_version_x86.cpp, since JDK 11).
+10:-XX:UseAVX=2
