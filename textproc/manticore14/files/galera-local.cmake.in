cmake_minimum_required ( VERSION 3.17 )

# galera of the FreeBSD port of azsupport/ports: its sources and those of wsrep-API
# in place (distfiles of the port), not a download with a checksum; Boost (its
# headers) and OpenSSL the ones of the build of Manticore; Release, no debug (upstream:
# RelWithDebInfo, -O3 -g), with the flags of the port from the environment
project ( galera-prebuild NONE )

include ( ExternalProject )
ExternalProject_Add ( galera_populate
		SOURCE_DIR @GALERA_PLACE@
		CMAKE_CACHE_ARGS -DWSREP_PATH:STRING=@WSREP_PLACE@ -DCMAKE_BUILD_TYPE:STRING=Release -DGALERA_REV:STRING=@GALERA_REV@
			-DBoost_NO_BOOST_CMAKE:BOOL=@Boost_NO_BOOST_CMAKE@ -DBOOST_ROOT:PATH=@BOOST_ROOT@ -DBoost_NO_SYSTEM_PATHS:BOOL=@Boost_NO_SYSTEM_PATHS@
			-DOPENSSL_ROOT_DIR:PATH=@OPENSSL_ROOT_DIR@
		BUILD_COMMAND "@CMAKE_COMMAND@" --build . --config Release
		INSTALL_COMMAND "@CMAKE_COMMAND@" --install . --config Release --prefix "@GALERA_BUILD@"
		)
