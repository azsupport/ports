# mail/postfix-mysql: mail/postfix with MySQL maps (the client library of
# databases/mariadb1011-client), in the place of the flavor mysql of the official
# mail/postfix (aZ, 15.11.2026); the same files, one of the two installed.

PKGNAMESUFFIX=	-mysql
COMMENT=	Secure alternative to widely-used Sendmail (with MySQL support, of azsupport/ports)

MASTERDIR=	${.CURDIR}/../postfix

.include "${MASTERDIR}/Makefile"
