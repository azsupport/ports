# mail/dovecot-mysql: mail/dovecot with the SQL driver of MySQL (the client library of
# databases/mariadb1011-client), in the place of the flavor mysql of the official
# mail/dovecot (aZ, 15.11.2026); the same files, one of the two installed.

PKGNAMESUFFIX=	-mysql
COMMENT=	Secure, fast and powerful IMAP and POP3 server (with MySQL support, of azsupport/ports)

MASTERDIR=	${.CURDIR}/../dovecot

.include "${MASTERDIR}/Makefile"
